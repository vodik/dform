// What dform offers a provider (DESIGN.org R-13, WORK.org R-13b's
// amendments): the credentialed transports, with the credential already
// applied, so a provider does protocol logic only.
//
// The host owns TLS (client certificates, the machine's proxy and CA),
// SSH (keys from the agent), git (a mirror in the XDG cache, pushed with
// the host's keys) and the operator's credentials. A provider names a
// credential the operator granted it in dform.toml
// (`[providers.k8s] credentials = ["kubeconfig:prod"]`) and gets a handle;
// the host applies the value inside its own call, and the value is never
// passed to the provider.
//
// These interfaces are defined once, here, and offered on two transports:
// as imports to a component (`world hosted-provider`, run by wasmtime),
// and as the `Host` gRPC service a native provider calls back into dform
// on (proto/dform/v1/host.proto, which mirrors this file). The SDK
// (crates/dform-sdk) presents one API over both.
//
// Grants, not walls: these imports are the easy path, not the only one.
// A component may import `wasi:http`, `wasi:sockets` or `wasi:filesystem`
// directly when dform.toml grants them (`[providers.NAME] allow =
// ["wasi:sockets"]`); it then gives up the host's TLS, retries, waits and
// audit for what it does there. `dform provider check` prints what a
// provider imports and what it is granted.
//
// The calls that wait on the world (`http.send`, `io.read`,
// `io.read-versioned`, `ssh.exec`) are `async func`s: under the component
// model's async ABI (WASI 0.3) each is a subtask, so a component keeps
// several in flight from one call (a Read that fetches two documents at
// once, a Configure that submits every OpenAPI document of a cluster)
// and the host's window paces them, with no thread in the component.
// Large bodies are `list<u8>` until they are `stream<u8>`, additively.

package dform:host@1.0.0;

interface types {
  // How a failure is handled, the classes dform's own retry policy reads
  // (R-81): a `final` one fails the same way again; a `retryable` one
  // changed nothing and is transient (a 429 or a 5xx, a refused
  // connection); a `maybe-applied` one got no answer and may have taken
  // effect (a timeout after the request was sent).
  enum error-class {
    final,
    retryable,
    maybe-applied,
  }

  // A failure: its class, and what it says (naming the host, the URL or
  // the credential, never a credential's value).
  record error {
    class: error-class,
    message: string,
  }

  // A read of something the world has not reached yet (the file a
  // cloud-init writes, the host that is still booting) is `not-yet`, not
  // an error: the engine waits on it as it waits on an open null (R-81,
  // within the provider's `timeout`), where an error fails the call.
  variant not-yet-or-error {
    not-yet(string),
    error(error),
  }

  record endpoint {
    host: string,
    port: u16,
  }

  // A credential the operator granted this provider, by name
  // (`KIND:NAME`, `kubeconfig:prod`): a handle, never the value. The host
  // applies it to a request (`http.send`'s `auth`).
  resource credential {
    // The name it was opened by.
    name: func() -> string;
    // The endpoint the credential is for, when it names one (a
    // kubeconfig's server): not secret, so the provider may build URLs
    // against it.
    endpoint: func() -> option<string>;
    // The namespace the credential defaults to, when it names one (a
    // kubeconfig context's): not secret.
    namespace: func() -> option<string>;
  }

  // A forwarded port (`ssh.forward`): a handle `http.send` takes as
  // `via`, never a local port a provider could hand elsewhere.
  resource tunnel {
    // Where it leads.
    to: func() -> endpoint;
  }
}

// The operator's credentials, by name.
interface secrets {
  use types.{credential, error};

  // Open the credential `name` (`KIND:NAME`). Refused, naming the
  // provider and the credential, unless dform.toml's `[providers.NAME]
  // credentials` grants it; refused when the operator has no value for it.
  open: func(name: string) -> result<credential, error>;
}

// HTTP, with TLS by the host: the machine's CA and proxy (`HTTPS_PROXY`,
// `NO_PROXY`), client certificates from a credential.
interface http {
  use types.{credential, tunnel, error};

  record request {
    method: string,
    url: string,
    headers: list<tuple<string, string>>,
    body: list<u8>,
    // At most this long, else the host's default; a request that timed
    // out after it was sent is `maybe-applied`.
    timeout-ms: option<u32>,
    // The limit it counts against, in the provider's word: the host
    // paces each bucket by what the server answers it. None: the default.
    bucket: option<string>,
    // The session of the call it is sent for (a configured instance of
    // the provider): each session's buckets are paced apart. 0: none, a
    // request outside a call.
    session: u64,
  }

  record response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }

  // Send `req`. `auth` is applied by the host by its kind: a bearer token
  // or a basic pair as the Authorization header, a client certificate (and
  // its CA) to the TLS session, a kubeconfig as whichever of those its
  // user has, a `signed` one as its provider's signer's material says
  // (`signer`: each request signed as it is sent). `via` routes it
  // through a tunnel (`ssh.forward`). A status the server answered (a
  // 404, a 500) is a response, not an error.
  send: async func(req: request, auth: option<borrow<credential>>, via: option<borrow<tunnel>>) -> result<response, error>;
}

// Reading a location (R-153, R-155): one reader for every scheme, a
// location the uri `io.read` takes, as a program's `io.read` does. The host reads its own schemes (`data:`,
// `ssh://USER@HOST/PATH` over SFTP, `https://`, `git+https://` and
// `git+ssh://` at `?ref=` through its mirrors, `s3://BUCKET/KEY`) with the
// operator's credentials by name, and routes a scheme a provider's
// manifest declares to that provider: one cache, one known-hosts store,
// one timeout policy, whoever reads. A read is refused, naming the
// provider and the location, unless dform.toml grants it by scheme and
// host pattern (`[providers.NAME] reads = ["https://github.com/*"]`). What
// the world has not reached yet (a host still booting, an object not
// written) is `not-yet`.
//
// A provider whose manifest declares schemes (`schemes = ["gs"]`) serves
// this same interface for them; the host calls it there, never one
// provider another. `io` is read-only: a write is an effect with no state
// to converge, a provider's apply (`ssh.write`, below, is the host's for
// one), never a program's.
interface io {
  use types.{not-yet-or-error};

  // What a source answers of a location (R-172): the bytes, and the
  // version it names them by when it keeps versions (a secret manager's
  // version id, `3`), which `?version=` on the same location reads again.
  // The host records the version in the plan file, so `apply PLAN` refuses
  // a location that has moved since.
  record document {
    data: list<u8>,
    version: option<string>,
  }

  // The bytes at `location`.
  read: async func(location: string) -> result<list<u8>, not-yet-or-error>;
  // The bytes at `location` and their version.
  read-versioned: async func(location: string) -> result<document, not-yet-or-error>;
}

// SSH, with keys from the agent. Commands are argv, never a shell string:
// no quoting class, and the audit shows the real command. A file is read
// through `io` (`ssh://USER@HOST/PATH`).
interface ssh {
  use types.{endpoint, tunnel, error, not-yet-or-error};

  record target {
    host: string,
    user: string,
    // 22 when absent.
    port: option<u16>,
  }

  record run {
    // The exit status; -1 when the command was killed by a signal.
    status: s32,
    stdout: list<u8>,
    stderr: list<u8>,
  }

  // Run `argv` on `on`. A host that does not answer yet is `not-yet`.
  exec: async func(on: target, argv: list<string>, stdin: option<list<u8>>) -> result<run, not-yet-or-error>;
  // Write `data` to `path` with `mode` (SFTP).
  write: func(on: target, path: string, data: list<u8>, mode: u32) -> result<_, error>;
  // Forward a connection through `via` to `to` (an API behind a bastion).
  forward: func(via: target, to: endpoint) -> result<tunnel, error>;
}

// Git: a commit, onto a local repository (pushing waits on gitoxide). A
// repository's file is read through `io`
// (`git+https://HOST/OWNER/REPO/PATH?ref=TAG`), from the host's mirror in
// `$XDG_CACHE_HOME/dform/git/`.
interface git {
  use types.{error};

  record file {
    path: string,
    data: list<u8>,
  }

  // Commit `files` onto `branch` of `repo` with `message`, and push it:
  // the new commit's id.
  commit: func(repo: string, branch: string, files: list<file>, message: string) -> result<string, error>;
}

// What the provider wants the operator to see, with dform's own output.
interface log {
  enum level {
    debug,
    info,
    warn,
    error,
  }

  log: func(level: level, message: string);
}

// A provider's signer: what turns the operator's grant of a credential
// its provider makes (`signed`, `kubeconfig`) into the credential's
// material, and signs a request with it, for a provider whose API wants
// its requests signed with a secret (OVH's application keys, AWS's
// SigV4) or whose credential is a file of its own (a kubeconfig). It is
// sans-I/O: it names what it needs (the value the grant gives, a
// variable, a file, a command's output, a fetch of one URL), the host
// performs each, under the operator's grant, and hands it the results;
// it never reaches the world itself. The host runs it apart from
// the provider (a component of `world signer-component`, which imports
// nothing, or a native provider's `Signer` service) and holds the
// material between its calls: the provider that talks to the network
// never holds the secret, and the signer cannot reach the network.
interface signer {
  // A request to sign, or a fetch to perform.
  record request {
    method: string,
    url: string,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }

  // A fetch's answer, and the host's time when it came, in seconds since
  // the epoch (a server's clock is read against it).
  record response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
    at: u64,
  }

  // A command to run: its argv (never a shell string), and variables set
  // for it beside the host's own.
  record command {
    argv: list<string>,
    env: list<tuple<string, string>>,
  }

  // What the host performs for the signer, in order.
  variant need {
    // These environment variables: the ones set, by name. Only for
    // `KIND:environment`.
    env(list<string>),
    // A file's bytes: `~/` its path under the operator's home; a relative
    // path is the directory's of the operator's file (`KIND:NAME`), else
    // the working directory's.
    file(string),
    // A command's standard output, run under the operator's grant, its
    // standard error the host's log.
    exec(command),
    // This request, sent as it is to exactly its URL, unauthenticated.
    fetch(request),
    // The value the grant gives, when it gives one: the settings a
    // program gave the provider, by setting, or the operator's file
    // (`KIND:NAME`), named by its kind; none for `KIND:environment`.
    given,
  }

  // What a need got, in the order of the needs.
  variant got {
    env(list<tuple<string, string>>),
    // None: there is no such file.
    file(option<list<u8>>),
    exec(list<u8>),
    fetch(response),
    given(list<tuple<string, list<u8>>>),
  }

  // A client certificate and its key, PEM.
  record tls-client {
    cert: list<u8>,
    key: list<u8>,
  }

  // One way the host applies the material.
  variant recipe {
    // `Authorization: Bearer TOKEN`.
    bearer(string),
    // These headers, on each request.
    headers(list<tuple<string, string>>),
    // Each request signed: `sign`, as the host sends it.
    signed,
    // The TLS session's client certificate.
    tls-client(tls-client),
    // Each request through this proxy, an `http://` URL.
    proxy(string),
    // A CA to trust beside the machine's, PEM.
    ca(list<u8>),
    // The server not verified.
    insecure,
    // The name TLS offers and verifies in place of the URL's host.
    server-name(string),
  }

  // The credential, as the signer made it: its bytes (the signer's own
  // encoding, opaque to the host), each way the host applies it, and
  // when it stops working (seconds since the epoch), when it does: the
  // host asks `refresh` before then. What it is for, when it says (the
  // server, the namespace it defaults to), is not secret: the provider
  // reads it off the credential it opened.
  record material {
    bytes: list<u8>,
    recipe: list<recipe>,
    expires: option<u64>,
    endpoint: option<string>,
    namespace: option<string>,
  }

  // What a step came to: more to perform, or the material.
  variant outcome {
    more(list<need>),
    material(material),
  }

  // What the signer needs first.
  needs: func() -> result<list<need>, string>;
  // The next step, given what the last needs got.
  step: func(got: list<got>) -> result<outcome, string>;
  // `req` signed with `material` at `now`, the host's time in seconds
  // since the epoch: the request as it is to be sent.
  sign: func(req: request, material: material, now: u64) -> result<request, string>;
  // The material renewed before it expires, at `now`.
  refresh: func(material: material, now: u64) -> result<outcome, string>;
}

// A signer as a component: it exports `signer` and imports nothing (no
// WASI, no host interface), so the host links it with nothing and refuses
// one that imports anything.
world signer-component {
  export signer;
}

// A provider the host runs: it serves `dform:provider/provider` and may
// import the host's interfaces. The WASI imports are there to be granted:
// a component imports only what it uses, and the host refuses one that
// imports `wasi:sockets`, `wasi:http` or `wasi:filesystem` without the
// grant, naming the provider and the interface. What Rust std links
// (environment, stdio, exit, clocks, random) needs none.
//
// WASI 0.3 only: what std links on wasm32-wasip3 (nightly) and what the
// SDK's bindings name (`wasi:clocks/monotonic-clock`'s `wait-for`).
world hosted-provider {
  import types;
  import secrets;
  import http;
  import io;
  import ssh;
  import git;
  import log;
  include wasi:cli/imports@0.3.0;
  import wasi:http/client@0.3.0;

  export dform:provider/provider@1.0.0;
}

// A provider whose manifest declares schemes (R-153): a hosted provider
// that serves `io` for them, which the host calls for a read of one.
world scheme-provider {
  include hosted-provider;
  export io;
}
