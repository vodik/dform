# Mock Kubernetes provider: a hand-written subset of the Kubernetes OpenAPI
# document (v1.30), fifteen kinds. No client, no cluster: the fake provider
# plans and applies these against a world file.
#
# Paths are the object's own JSON paths (metadata.name, spec.replicas, ...).
# Conventions taken from the API:
#   - metadata.name is optional_computed: a client may send generateName and
#     let the API server pick the name (minted as generateName + a suffix). metadata.namespace is optional_computed
#     too (the server fills in the client's default namespace).
#   - fields the API server defaults (spec.replicas, spec.type, clusterIP, ...)
#     are optional_computed: the program may set them, else Apply picks them.
#   - status.* and metadata.uid / resourceVersion / generation /
#     creationTimestamp are computed; uid is the identity.
#   - type_list_key mirrors x-kubernetes-list-map-keys (containers, ports,
#     env, volumes, ...): the plan diffs those lists by key, not by index.
#   - Secret.data and Secret.stringData are sensitive.
#
# type_mint gives the mock's answer for a server-picked value.

edition 2026.

# Namespace (core/v1)
type_provider(k8s.namespace, kubernetes).
# Deleting a namespace deletes what is in it: the old one goes first.
type_replace(k8s.namespace, destroy_first).
type_attr(k8s.namespace, metadata.name, string, [optional_computed, id]).
type_mint(k8s.namespace, metadata.name, "{doc:metadata.generateName}{hash}").
type_attr(k8s.namespace, metadata.generateName, string, []).
type_attr(k8s.namespace, metadata.labels, map, []).
type_attr(k8s.namespace, metadata.annotations, map, []).
type_attr(k8s.namespace, metadata.uid, string, [computed, id]).
type_attr(k8s.namespace, metadata.resourceVersion, string, [computed]).
type_attr(k8s.namespace, metadata.generation, int, [computed]).
type_attr(k8s.namespace, metadata.creationTimestamp, string, [computed]).
type_mint(k8s.namespace, metadata.uid, "uid-{name}-{hash}").
type_mint(k8s.namespace, metadata.resourceVersion, "{n}").
type_mint(k8s.namespace, metadata.generation, 1).
type_mint(k8s.namespace, metadata.creationTimestamp, "2026-01-01T00:00:00Z").
type_attr(k8s.namespace, spec.finalizers, list, [computed]).
type_mint(k8s.namespace, spec.finalizers, [kubernetes]).
type_attr(k8s.namespace, status.phase, string, [computed]).
type_mint(k8s.namespace, status.phase, "Active").

