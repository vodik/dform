# A string spans lines (R-61), and `\` at a line end joins the line with
# the next, whose leading whitespace is kept.
output note = "a long line, \
  continued"

# A string in a hole is the hole's own (R-175): holes nest to any depth,
# and a brace in an inner string is a character of it.
output init = "#cloud-config
${yaml.encode({ packages: ["nftables"], runcmd: ["${install} sh -s - ${"server"}", "echo }"] })}"

let install = "curl -sfL https://get.k3s.io |"
