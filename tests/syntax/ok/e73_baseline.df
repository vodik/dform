policy baseline {
  # Grants are partition patterns: this pack sits above readers of .tags,
  # of iam.policy's .statements and of settings' .audit.sinks, and may read
  # every other attribute path.
  contributes arg to _ at .tags.
  contributes arg to iam.policy at .statements.
  contributes arg to settings at .audit.sinks.

  arg(T, A, .tags, { team: "platform" }) :- want(T, A).

  # Reads .name of the same type it writes .statements on: legal under
  # (type, path) partitions, a self-loop under type-only partitions.
  arg(iam.policy, A, .statements, [ { action: "org.read", resource: "org" } ]) :-
    env(prod), want(iam.policy, A), attr(iam.policy, A, .name, "app").

  arg(settings, prod, .audit.sinks, ["s3"]).

  # Prod forces deletion protection on for every database: an @override,
  # not a conflict with the module's default of false.
  arg(db.postgres, Db, .deletion_protection, true) @override :- env(prod), want(db.postgres, Db).

  deny(db_public, "db must not be public", { db: Db }) :-
    want(db.postgres, Db), not attr(db.postgres, Db, .public, false).

  warn(audit_logging, "prod should enable audit logging", {}) :-
    env(prod), not setting(prod, .audit.enabled, true).
}.
