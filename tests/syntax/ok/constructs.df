# One of everything the grammar lowers today.
# A keyed stack: each value of its keys is its own deployment.
key tier: string = "dev"
key region: string = "us-east1"
input relation: string = "an input named relation"
input store { backup_days: int = 1 }
input gke { static_ips: any }
input seen from yaml.decode(io.read("seen.yaml"))[_].rows
input peers from csv.decode(io.read("peers.csv"))
input pinned from yaml.decode(io.read("git+https://github.com/acme/ops/pinned.yaml?ref=main"))
decl seen(a: string, b: int)
decl peers(env: enum("dev", "prod"), name: string)
decl pinned(name: string)
decl provided(a, b)
decl project(id: int, network_name: string)
# Patterns (R-58): after `in`, on the left of `=`, as an argument.
decl labels(l)
decl images(i)
decl p(a) mixed
decl q(a) mixed

project(1, "net-a")
names(n) where project(network_name: n)

label(k, v) where labels(l), (k, v) in l
host_of(h) where labels(l), { host: h } = l
tagged(repo, tag) where images(i), (repo, tag) = str.split(i, ":", 1)
untagged(i) where images(i), not (_, _) = str.split(i, ":", 1)
ids(i) where project({ id: i })
# Spread (R-199): a literal's fields or elements, and an object pattern's rest.
spread(x) where labels(l), x = { ..l, team: "web", spec: { ..l.spec, replicas: 3 } }
spread_list(x) where images(i), x = [..0..3, ..[i], 9]
rest(h, body) where labels(l), { host: h, ..body } = l

# A module, checks.df beside this file, by its path; and a component.
use checks {
  vpc_inst(i) where vpc_inst(i)
  q(n) where q(n)
} where env("prod")

component m {
  input on: bool
  output vpc: addr = vpc

  resource net.vpc vpc @default {
    cidr = "10.0.0.0/16"
    tags = { team: "x", "k-v": 1 }
    size = 2 @override
    list[0].name = "a"
    audit.sinks += ["s3"]
  } where on == true

  on_vpc("vpc") where on == true
  iam_need("app", "net.read", ref(net.vpc, "vpc", "id"))
}

resource m main { on = true }

component tagging {
  arg(t, a_, "tags", { owner: "ops" }) @override where want(t, a_)
}

resource tagging tags {}

q(1) where env("prod")

set { store.backup_days = 3 } @default where env("prod")
set { gke.static_ips = { "pngu-grpc": { type: "INTERNAL" } } } where env("prod")
set from yaml.decode(io.read("settings.yaml")) @override where env("prod")

env("prod")
p(x_) where {
  q(x_)
  x_ == 1 + 2 * 3 - -4 / (5 % 2)
  x_ != 0
  x_ >= 1
  x_ <= 9
  x_ > 0
  x_ < 10
}
r(v) where v = gke.static_ips."pngu-grpc".type
s(v) where q(x_), o = { a: { b: x_ } }, v = o.a.b
t(l) where l = [ x_ | q(x_) ], 1 in l, 2 not in l
u(a_) where ref(net.vpc, "main.vpc", "id") = a_
adopt(net.vpc["main.vpc"], "vpc-123")
moved(net.vpc, "old.vpc", net.vpc["main.vpc"])
lifecycle(net.vpc["main.vpc"], "prevent_destroy")
ignore_changes(net.vpc["main.vpc"], "tags.owner")
counts(n_) where n_ = count(x_), q(x_)
deny "q must not be empty" where not q(1)
v("input", "output", "settings", "type") where input("env", _), output("k", _)
p(5)
q(2)
w(v) where v = main.vpc, checks.listed("main")
vpc_inst("main")
x(i, a_) where vpc_inst(i), output(m[i], "vpc", a_)
