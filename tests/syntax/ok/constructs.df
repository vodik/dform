edition 2026

# One of everything the grammar lowers today.
# A keyed stack: each value of its keys is its own deployment.
key tier: string = "dev"
key region: string = "us-east1"
input relation: string = "an input named relation"
input seen(a, b) from facts("seen.facts")
input peers(env: enum("dev", "prod"), name: string) from csv("peers.csv")
input pinned(name: string) from yaml(git("ops.git", "main", "pinned.yaml"))

decl provided(a, b)
decl project(id: int, network_name: string)

project(1, "net-a")
names(n) where project(network_name: n)

# Patterns (R-58): after `in`, on the left of `=`, as an argument.
decl labels(l)
decl images(i)
label(k, v) where labels(l), (k, v) in l
host_of(h) where labels(l), { host: h } = l
tagged(repo, tag) where images(i), (repo, tag) = str.split(i, ":", 1)
untagged(i) where images(i), not (_, _) = str.split(i, ":", 1)
ids(i) where project({ id: i })

# A module, checks.df beside this file, by its path; and a component.
use checks where env("prod")

component m {
  input on: bool

  resource net.vpc vpc @default {
    cidr = "10.0.0.0/16"
    tags = { team: "x", "k-v": 1 }
    size = 2 @override
    list[0].name = "a"
    audit.sinks += ["s3"]
  } where on == true

  on_vpc("vpc") where on == true
  iam_need("app", "net.read", ref(net.vpc, "vpc", "id"))
  output vpc: addr = vpc
}

instance m main { on = true }

component tagging {
  arg(t, a_, "tags", { owner: "ops" }) @override where want(t, a_)
}

instance tagging tags

q(1) where env("prod")

settings e @default {
  db = { backup_days: 3 }
} where env(e)

env("prod")
p(x_) where q(x_), x_ == 1 + 2 * 3 - -4 / (5 % 2), x_ != 0, x_ >= 1, x_ <= 9, x_ > 0, x_ < 10
r(v) where v = settings["prod"].gke.static_ips."pngu-grpc".type
s(v) where q(x_), o = { a: { b: x_ } }, v = o.a.b
t(l) where l = [ x_ | q(x_) ], 1 in l, 2 not in l
u(a_) where ref(net.vpc, "main::vpc", "id") = a_
adopt(net.vpc["main::vpc"], "vpc-123")
moved(net.vpc, "old::vpc", net.vpc["main::vpc"])
lifecycle(net.vpc["main::vpc"], "prevent_destroy")
ignore_changes(net.vpc["main::vpc"], "tags.owner")
counts(n_) where n_ = count(x_), q(x_)
deny "q must not be empty" where not q(1)
v("input", "output", "settings", "type") where input("env", _), output("k", _)
decl p(a) mixed
decl q(a) mixed
p("a")
q("b")
w(v) where v = main.vpc, checks.listed("main")
vpc_inst("main")
x(i, a_) where vpc_inst(i), output(m[i], "vpc", a_)
