# gke_platform.df, direction E. The platform stack for one GCP project per environment.

input env: enum("dev", "stg", "prod") = "dev"
decl peering(env: symbol, name: string, peer_network: string)

use google { source = "registry.dform.dev/google", version = ">=6" }
use k8s { source = "registry.dform.dev/k8s", version = ">=3" }
use file { source = "registry.dform.dev/file" }

########################################
# Settings: base layer plus per-environment overrides
########################################

type settings {
  project_id: string
  project_name: string
  region: string
  network_name: string
  regional_proxy_cidr: inet
  gke: {
    control_plane_cidr: inet check control_plane_cidr.bits == 28 # checkable: lives in the cell
    subnet_cidr: inet check subnet_cidr.bits == 22
    pods_cidr: inet check pods_cidr.bits == 21
    services_cidr: inet check services_cidr.bits == 21
    static_ips: map({ type: enum("INTERNAL") }) # was a constraint rule
  }
}

set {
  region = "us-east1"
  gke.static_ips = { "gke-platform-grpc" = { type = "INTERNAL" } }
} @default

env_name("dev")
env_name("stg")
env_name("prod")

set {
  project_id = "platform-dev-973682"
  project_name = "platform-dev"
  network_name = "platform-dev-network"
  regional_proxy_cidr = "10.193.0.0/24"
  gke = {
    control_plane_cidr = "172.16.3.96/28",
    subnet_cidr = "10.141.76.0/22",
    pods_cidr = "10.141.80.0/21",
    services_cidr = "10.141.88.0/21",
  }
} where env == "dev"

set {
  project_id = "platform-stg"
  project_name = "platform-stg"
  network_name = "platform-stg-network"
  regional_proxy_cidr = "10.193.1.0/24"
  gke = {
    control_plane_cidr = "172.16.3.112/28",
    subnet_cidr = "10.141.100.0/22",
    pods_cidr = "10.141.104.0/21",
    services_cidr = "10.141.112.0/21",
  }
} where env == "stg"

# prod elided; same shape.

########################################
# Peerings, an env-keyed table
########################################

peering("dev", "envoy-dev", "projects/envoy-dev-426188/global/networks/envoy-dev-network")
peering("stg", "envoy-stg", "projects/envoy-stg-597462/global/networks/envoy-stg-network")
peering("stg", "edge-stg", "projects/edge-stg/global/networks/envoy-proxy-stg")
peering("prod", "edge-prod", "projects/edge-prod/global/networks/envoy-proxy-prod")

########################################
# Derived project facts for the active env
########################################

project(id, name, region, net_id) where
  e = env,
  setting(e, "project_id", id),
  setting(e, "project_name", name),
  setting(e, "region", region),
  setting(e, "network_name", net_name),
  net_id = str.format("projects/%s/global/networks/%s", id, net_name),

########################################
# Network
########################################

resource google.compute_subnetwork gke_subnet {
  project = id
  region
  network = net_id
  name = str.format("%s-gke-subnet", name)
  ip_cidr_range = subnet_cidr
  subnet_private_access = true
  secondary_ranges = [
    { range_name = str.format("%s-gke-pods-range", name), ip_cidr_range = pods_cidr },
    { range_name = str.format("%s-gke-svc-range", name), ip_cidr_range = svc_cidr },
  ] # Keyed on .range_name per the google schema
} where
  project(id, name, region, net_id),
  e = env,
  setting(e, "gke.subnet_cidr", subnet_cidr),
  setting(e, "gke.pods_cidr", pods_cidr),
  setting(e, "gke.services_cidr", svc_cidr),

resource google.compute_subnetwork regional_proxy {
  project = id
  region
  network = net_id
  name = str.format("%s-proxy", name)
  purpose = "REGIONAL_MANAGED_PROXY"
  role = "ACTIVE"
  ip_cidr_range = proxy_cidr
} where project(id, name, region, net_id), e = env, setting(e, "regional_proxy_cidr", proxy_cidr)

resource google.compute_network main {
  project = id
  name = net_id
  peerings = [ { name = n, peer_network = pn } | peering(e, n, pn) ]
} where project(id, _, _, net_id), e = env

# One static address per declared static IP; the map explodes into rows.
static_ip(ip_name, type_)
  where e = env, setting(e, "gke.static_ips", ips), member_kv(ips, ip_name, { type = type_ })

resource google.compute_address "${s}" {
  project = id
  region
  name = ip_name
  address_type = type_
  subnetwork = ref(google.compute_subnetwork, "gke_subnet", "id")
} where
  project(id, _, region, _),
  static_ip(ip_name, type_),
  s = str.format("static-ip-%s", ip_name),

########################################
# GKE: phase 1
########################################

resource gke.cluster gke_platform {
  cluster_type = "autopilot-private"
  env = e
  project_id = id
  project_name = name
  name = str.format("%s-gke", name)
  network_id = net_id
  subnetwork = ref(google.compute_subnetwork, "gke_subnet", "id")
  master_control_plane_cidr = cp_cidr
  ip_range_pods = str.format("%s-gke-pods-range", name)
  ip_range_services = str.format("%s-gke-svc-range", name)
  enable_secret_manager_addon = true
  deletion_protection = false @default
} where e = env, project(id, name, _, net_id), setting(e, "gke.control_plane_cidr", cp_cidr)

# Prod: deletion protection on, at normal rank, over the block's @default.
# Two ranks, one value each, no conflict. The lifecycle fact is policeable.
arg("gke.cluster", "gke_platform", "deletion_protection", true) where env == "prod"
lifecycle(gke.cluster["gke_platform"], "prevent_destroy") where env == "prod"

deny(
  "prod_deletion_protection",
  "prod cluster must have deletion protection",
  { cluster = "gke_platform" },
) where env == "prod", not attr("gke.cluster", "gke_platform", "deletion_protection", true)

########################################
# Kubernetes: phase 2. The provider is configured from phase-1 nulls.
########################################

# .endpoint and .ca_certificate are computed (open); .access_token is
# computed and sensitive (secret). This fact is definite and carries three
# nulls, so every kubernetes deformation is pending on them: phase 2.
provider_config(
  "k8s",
  {
    host = ref("gke.cluster", "gke_platform", "endpoint"),
    ca = ref("gke.cluster", "gke_platform", "ca_certificate"),
    token = ref(google.client_config, "current", "access_token"),
  },
)

resource k8s.namespace gke_platform { name = "gke-platform" }

resource k8s.deployment api {
  namespace = ref(k8s.namespace, "gke_platform", "name") # configured attribute: rewritten to an attr join
  image = "gcr.io/platform/api:1.42"
  replicas = 3
}

# The secret never appears in the store as bytes: the kubernetes provider
# resolves ?google.secret_manager_secret_version/db_pw#secret_data inside Apply.
resource k8s.secret db_credentials {
  namespace = ref(k8s.namespace, "gke_platform", "name")
  data = { password = ref(google.secret_manager_secret_version, "db_pw", "secret_data") }
}

# One node pool per zone the autopilot cluster actually used. .zones is an
# open null at plan time; member/2 over it is a content position, so this
# rule is stuck on ?gke.cluster/gke_platform#zones and the plan prints one pending
# group of unknown cardinality. After phase 1 it fires once per zone.
resource gke.nodepool "${np}" {
  cluster = ref("gke.cluster", "gke_platform", "id")
  zone = z
  min = 1
  max = 3
} where attr("gke.cluster", "gke_platform", "zones", zs), member(zs, z), np = str.format("np-%s", z)

# A policy that cannot be decided at plan time and says so: the aggregate
# has a stuck instance, so it is undetermined, and the deny is reported as
# undetermined until phase 1 resolves .zones.
zone_count(n) where n = count(z), attr("gke.cluster", "gke_platform", "zones", zs), member(zs, z)

deny("two_zones", "cluster must be in at least two zones", { cluster = "gke_platform" })
  where want("gke.cluster", "gke_platform"), zone_count(n), n < 2

########################################
# Monitoring: the dashboard JSON is a file extern, hashed, with provenance
########################################

use file

resource google.monitoring_dashboard gke_platform {
  project = id
  dashboard_json = dash
} where project(id, _, _, _), file.json("modules/monitoring/dashboard-gke-platform.json", dash)

output("active_env", e) where e = env
output("project_id", id) where project(id, _, _, _)
