edition 2026

# Names are resolved: a constant is quoted, a variable is bound where it is
# written, and no variable takes the name of a resource or a type namespace.
input env: enum("dev", "prod") = "dev"
resource net.vpc main { cidr = "10.0.0.0/16" }

prod_only(1) where env == prod
tagged(main) where want(net.vpc, main)
nets(net) where want(net, _)
twice(x) where x = cfg.region
