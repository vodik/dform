edition 2026

# A table's columns are typed, and never secret; its source is FORMAT(SOURCE).
input token from csv("tokens.csv")
input peers from xml("peers.xml")
input pins from yaml(git("ops.git", "pins.yaml"))
input dup from csv("dup.csv")
input typo from csv("typo.csv")

decl token(name: string, value: secret(string))
decl peers(name: string)
decl pins(name: string)
decl dup(name: string, name: int)
decl typo(name: strng)

component m {
  input inner from csv("inner.csv")
}
