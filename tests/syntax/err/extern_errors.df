edition 2026

# Externs are asked once their + arguments are ground: never negated, never
# in a recursive rule, never stated by the program, bound left to right.
provider file {}
extern next.hop(+from, -to)

paths("a.txt")
file.text("b.txt", "b")
missing(p) where paths(p), not file.text(p, _)
early(v) where file.text(p, v), paths(p)
reach(a, b) where next.hop(a, b), start(a)
reach(a, c) where reach(a, b), next.hop(b, c)
start("x")
arity(v) where paths(p), file.text(p, v, 1)
