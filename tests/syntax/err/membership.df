input tier: enum("a", "b") = "a"
input env: environment = "dev"

# `x in T` ranges over an enum type's values (R-70) and a provider
# namespace's resources (R-49); a cell is no type, a list type is no enum,
# and an attribute some type of the namespace lacks is no read.
type environment = enum("dev", "prod")
type environments = list(environment)
t(x) where x in tier
e(x) where x in env
l(x) where x in environments
spec(s) where r in k8s, s = r.spec
