# A decimal is a float (R-75): an int position refuses one, bytes are
# whole, and a duration has a unit.
input count: int = 0.5
input size: bytes = 1.5
input grace: duration = 0.5

# A quantity scales by an int only.
a(x) where x = 1Gi * 0.5
# An int parameter takes no float.
b(x) where x = str.slice("abc", 1.5)
