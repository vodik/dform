edition 2027

# E DR-3: the module interface is checked, predicates are private, and a
# policy pack writes only inside its grants.
module network {
  input vpc_net: inet
  input zones: list(string) = ["a"]
  export subnet_of
  contributes _.tags

  zone_index("a", 0)
  output vpc: addr = "vpc"
  output peers = []
}

instance network main { vpc_cidr = "10.0.0.0/16" }
instance network peer {}

reads_private(z) if zone_index(z, _)

policy tags {
  contributes _.tags
  set r.tags = { team: "x" } if r in resource
  set r.labels = { team: "x" } if r in resource
  set v.cidr = "10.0.0.0/8" if v in net.vpc
}

use tags
