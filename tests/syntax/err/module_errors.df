edition 2026

# E DR-3, R-65: a component's interface is checked and its predicates are
# private.
component network {
  input vpc_net: inet
  input zones: list(string) = ["a"]

  zone_index("a", 0)
  output vpc: addr = "vpc"
  output peers = []
}

instance network main { vpc_cidr = "10.0.0.0/16" }
instance network peer {}

reads_private(z) where zone_index(z, _)

component tags {
  set r.tags = { team: "x" } where r in resource
  set r.labels = { team: "x" } where r in resource
  set v.cidr = "10.0.0.0/8" where v in net.vpc
}

instance tags all
