# Spellings of earlier surfaces: each is one error with a hint that names
# the spelling of edition 2026.
component_def net { p("a") }
policy_pack base { p("b") }
apply_policy base
unique setting(2)
when p(1) { q(1) }
with env = "prod"
constraint "m" where p(1)
apply base
k = 1
r.tags = {}
decl p/2
export p/2
module network {
  input cidr: inet
}
import "modules/network.df"
policy baseline {}
input relation p/2 from file("p.facts")
s(x) where exists x
t(x) where some x in [1]
u(x) where q(x), x == .cidr
v(x) where q{a: x}
resource t a {
  for q(x)
  b = x
}
