edition 2027

# Spellings of earlier surfaces: each is one error with a hint that names
# the spelling of edition 2027.
component_def net { p("a") }
policy_pack base { p("b") }
apply_policy base
unique setting(2)
when p(1) { q(1) }
with env = "prod"
constraint "m" if p(1)
apply base
k = 1
r.tags = {}
decl p/2
export p/2
input relation p/2 from file("p.facts")
s(x) if exists x
t(x) if some x in [1]
u(x) if q(x), x == .cidr
v(x) if q{a: x}
resource t a {
  for q(x)
  b = x
}
