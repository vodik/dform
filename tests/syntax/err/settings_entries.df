edition 2026

# A settings block gives inputs: the program's own, a field of an object
# one, or a used module's; at the normal rank unless marked.
input env: string = "dev"
input db { size: int = 1 }
let region = "us-east-1"
settings { db.sz = 2 } where env == "prod"
settings { nope = 1 }
settings { region = "eu-west-1" }
settings { db.size += 1 }
