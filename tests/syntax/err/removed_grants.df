# R-5: `contributes` is gone, and R-65 `export`: a write needs no grant,
# a component's relation leaves it through an output, a module's items are
# public.
component network {
  export subnet_of
  contributes iam_need
  export type subnets
  type subnets = list(string)
  subnet_of("a", "vpc")
}

component tags {
  contributes t.tags
  set r.tags = { team: "x" } where r in resource
}
