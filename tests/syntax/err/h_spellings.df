edition 2027

# Proposal H: where two spellings of one meaning would survive, the
# compiler rejects the one that is not the construct's and names the other.
input env: string = "dev"
resource net.vpc main { cidr = "10.0.0.0/16" }
settings prod { size = 1 }

# H-5: a contribution with no condition to a block of the same scope is
# that block's entry; a program's own input takes a default or --set.
set main.tags = { team: "x" }
set settings["prod"].size = 2
set env = "prod"

# H-7: an output is one statement, its value in it.
output vpc: net.vpc

# H-8: no rule reads deny/2.
deny "no" if env == "x"
denied(m) if deny(m)

# H-10: a resource in scope is named by its name; a type is a known type.
a(c) if c = net.vpc["main"].cidr
b(c) if c = net.vpc.main.cidr
d(c) if c = net.vcp["x"].cidr

# H-15: the core, where a surface form says the same.
e(x) if want(net.vpc, x)
f(v) if attr(net.vpc, "main", "cidr", v)
arg(net.vpc, "main", "size", 3)
output("k", 1)
deny("m") if env == "y"
g(x) if member([1], x)
