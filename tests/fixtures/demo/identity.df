#| The permissions the stack's components need: rows its `use` gives.
input iam_need
decl iam_need(role: string, action: string, resource: string)

#| The app's role, and one policy of every permission. The role holds its
#| policies: a relationship whose state lives on one side is that side's
#| attribute, a set any module may add to (`set r.policies = [p] where ..`).
resource iam.role app_role {
  name = "app"
  assume = { principals: ["k8s.serviceaccount.app"] }
  policies = [app_policy]
}

resource iam.policy app_policy {
  name = "app"
  # List comprehension sugar for collect_list(...)
  statements = [ { action: a, resource: r } | iam_need("app", a, r) ]
}
