# adv2: Rule 3 coarseness. One rule with head `want` is stuck (the nodepool,
# on ?google.container_cluster/pngu#zones). An UNRELATED negation over `want` and an
# UNRELATED aggregate over `want` must not become undetermined.
# Run with --provider gke.

resource google.container_cluster pngu { name = "pngu-gke" }

resource google.container_node_pool np {
  cluster = ref("google.container_cluster", "pngu", "id")
  zone = z
} where arg("google.container_cluster", "pngu", "zones", zs), z in zs, np = format("np-%s", z)

resource k8s.namespace pngu { name = "pngu" }

# Unrelated negation over want (different type): decidable now.
deny "namespace without deployment" { ns: n } where n in k8s.namespace, not n in k8s.deployment

# Unrelated aggregate over want (different type): decidable now.
ns_count(l) where l = collect_set(n), n in k8s.namespace

deny "need the pngu namespace" where ns_count(l), not "pngu" in l

# Related negation (same type as the stuck head): correctly undetermined.
deny "no nodepool in zone b" where {
  "pngu" in google.container_cluster
  not "np-us-east1-b" in google.container_node_pool
}

provider fake
