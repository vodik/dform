# The pack adv3b_pack_reads_same_path.df uses: a module, `use packs.same_path`.
type_lattice("iam.policy", "statements", "set")
set p.statements = [{ action: "org.read", resource: "org" }] where {
  p in iam.policy
  arg("iam.policy", p, "statements", s)
  { action: "org.read", resource: "org" } not in s
}
