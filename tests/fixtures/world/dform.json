{
  "resources": {
    "compute.vm::bastion": {
      "typ": "compute.vm",
      "name": "bastion",
      "attrs": {
        "private_ip": "10.50.0.21",
        "tags": {
          "team": "platform"
        }
      },
      "computed": {
        "id": "compute.vm:bastion"
      }
    },
    "db.postgres::database.main::db": {
      "typ": "db.postgres",
      "name": "database.main::db",
      "attrs": {
        "backup_days": 3,
        "multi_az": false,
        "public": false,
        "subnet_ids": [
          "net.subnet:network.main::private-us-test-1a",
          "net.subnet:network.main::private-us-test-1b"
        ],
        "tags": {
          "team": "platform"
        }
      },
      "computed": {
        "endpoint": "database.main::db.db.fake",
        "id": "db.postgres:database.main::db"
      }
    },
    "iam.policy::identity.main::app_policy": {
      "typ": "iam.policy",
      "name": "identity.main::app_policy",
      "attrs": {
        "name": "app",
        "statements": [
          {
            "action": "db.connect",
            "resource": "db.postgres:database.main::db"
          },
          {
            "action": "k8s.describe_cluster",
            "resource": "k8s.cluster:kubernetes.main::cluster"
          }
        ],
        "tags": {
          "team": "platform"
        }
      },
      "computed": {
        "id": "iam.policy:identity.main::app_policy"
      }
    },
    "iam.role::identity.main::app_role": {
      "typ": "iam.role",
      "name": "identity.main::app_role",
      "attrs": {
        "assume": {
          "principals": [
            "k8s.serviceaccount.app"
          ]
        },
        "name": "app",
        "tags": {
          "team": "platform"
        }
      },
      "computed": {
        "id": "iam.role:identity.main::app_role"
      }
    },
    "iam.role_policy_attachment::identity.main::attach": {
      "typ": "iam.role_policy_attachment",
      "name": "identity.main::attach",
      "attrs": {
        "policy_id": "iam.policy:identity.main::app_policy",
        "role_id": "iam.role:identity.main::app_role",
        "tags": {
          "team": "platform"
        }
      },
      "computed": {
        "id": "iam.role_policy_attachment:identity.main::attach"
      }
    },
    "k8s.cluster::kubernetes.main::cluster": {
      "typ": "k8s.cluster",
      "name": "kubernetes.main::cluster",
      "attrs": {
        "private_api": false,
        "subnet_ids": [
          "net.subnet:network.main::private-us-test-1a",
          "net.subnet:network.main::private-us-test-1b"
        ],
        "tags": {
          "team": "platform"
        },
        "version": "1.29"
      },
      "computed": {
        "api_endpoint": "https://kubernetes.main::cluster.k8s.fake",
        "ca_cert": "FAKECERT",
        "id": "k8s.cluster:kubernetes.main::cluster"
      }
    },
    "k8s.nodepool::kubernetes.main::default": {
      "typ": "k8s.nodepool",
      "name": "kubernetes.main::default",
      "attrs": {
        "cluster_id": "k8s.cluster:kubernetes.main::cluster",
