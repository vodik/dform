{
  "resources": {
    "compute.vm::bastion": {
      "typ": "compute.vm",
      "name": "bastion",
      "attrs": {
        "private_ip": "10.50.0.21",
        "tags": {
          "team": "platform"
        }
      },
      "computed": {
        "id": "compute.vm:bastion"
      }
    },
    "db.postgres::database::db": {
      "typ": "db.postgres",
      "name": "database::db",
      "attrs": {
        "backup_days": 3,
        "multi_az": false,
        "public": false,
        "subnets": [
          "net.subnet:main::private-us-test-1a",
          "net.subnet:main::private-us-test-1b"
        ],
        "tags": {
          "team": "platform"
        }
      },
      "computed": {
        "endpoint": "database::db.db.fake",
        "id": "db.postgres:database::db"
      }
    },
    "iam.policy::identity::app_policy": {
      "typ": "iam.policy",
      "name": "identity::app_policy",
      "attrs": {
        "name": "app",
        "statements": [
          {
            "action": "db.connect",
            "resource": "db.postgres:database::db"
          },
          {
            "action": "k8s.describe_cluster",
            "resource": "k8s.cluster:kubernetes::cluster"
          }
        ],
        "tags": {
          "team": "platform"
        }
      },
      "computed": {
        "id": "iam.policy:identity::app_policy"
      }
    },
    "iam.role::identity::app_role": {
      "typ": "iam.role",
      "name": "identity::app_role",
      "attrs": {
        "assume": {
          "principals": [
            "k8s.serviceaccount.app"
          ]
        },
        "name": "app",
        "tags": {
          "team": "platform"
        }
      },
      "computed": {
        "id": "iam.role:identity::app_role"
      }
    },
    "iam.role_policy_attachment::identity::attach": {
      "typ": "iam.role_policy_attachment",
      "name": "identity::attach",
      "attrs": {
        "policy": "iam.policy:identity::app_policy",
        "role": "iam.role:identity::app_role",
        "tags": {
          "team": "platform"
        }
      },
      "computed": {
        "id": "iam.role_policy_attachment:identity::attach"
      }
    },
    "k8s.cluster::kubernetes::cluster": {
      "typ": "k8s.cluster",
      "name": "kubernetes::cluster",
      "attrs": {
        "private_api": false,
        "subnets": [
          "net.subnet:main::private-us-test-1a",
          "net.subnet:main::private-us-test-1b"
        ],
        "tags": {
          "team": "platform"
        },
        "version": "1.29"
      },
      "computed": {
        "api_endpoint": "https://kubernetes::cluster.k8s.fake",
        "ca_cert": "FAKECERT",
        "id": "k8s.cluster:kubernetes::cluster"
      }
    },
    "k8s.nodepool::kubernetes::default": {
      "typ": "k8s.nodepool",
      "name": "kubernetes::default",
      "attrs": {
        "cluster": "k8s.cluster:kubernetes::cluster",
        "max": 3,
        "min": 1,
        "tags": {
          "team": "platform"
        }
      },
      "computed": {
        "id": "k8s.nodepool:kubernetes::default"
      }
    },
    "net.subnet::main::private-us-test-1a": {
      "typ": "net.subnet",
      "name": "main::private-us-test-1a",
      "attrs": {
        "cidr": "10.50.0.0/20",
        "tags": {
          "team": "platform"
        },
        "visibility": "private",
        "vpc": "net.vpc:main::vpc",
        "zone": "us-test-1a"
      },
      "computed": {
        "id": "net.subnet:main::private-us-test-1a"
      }
    },
    "net.subnet::main::private-us-test-1b": {
      "typ": "net.subnet",
