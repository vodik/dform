    },
    "net.vpc_peering::peer-main-peer": {
      "typ": "net.vpc_peering",
      "name": "peer-main-peer",
      "attrs": {
        "accepter_vpc": "net.vpc:peer::vpc",
        "requester_vpc": "net.vpc:main::vpc",
        "tags": {
          "team": "platform"
        }
      },
      "computed": {
        "id": "net.vpc_peering:peer-main-peer"
      }
