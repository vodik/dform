    "net.subnet::peer::private-us-test-1a": {
      "typ": "net.subnet",
      "name": "peer::private-us-test-1a",
      "attrs": {
        "cidr": "10.60.0.0/20",
        "tags": {
          "team": "platform"
        },
        "visibility": "private",
        "vpc": "net.vpc:peer::vpc",
        "zone": "us-test-1a"
      },
      "computed": {
        "id": "net.subnet:peer::private-us-test-1a"
      }
    },
    "net.subnet::peer::private-us-test-1b": {
      "typ": "net.subnet",
      "name": "peer::private-us-test-1b",
      "attrs": {
        "cidr": "10.60.16.0/20",
        "tags": {
          "team": "platform"
        },
        "visibility": "private",
        "vpc": "net.vpc:peer::vpc",
        "zone": "us-test-1b"
      },
      "computed": {
        "id": "net.subnet:peer::private-us-test-1b"
      }
    },
    "net.vpc::main::vpc": {
      "typ": "net.vpc",
      "name": "main::vpc",
      "attrs": {
        "cidr": "10.50.0.0/16",
        "tags": {
          "component": "network",
