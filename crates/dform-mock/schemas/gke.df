# C's two-phase GKE / kubernetes stack as E section 7.4 spells it (pngu.df).
#
# The cluster's endpoint, ca and zones are open; ids are fresh; the client
# token and the secret version's data are secret. k8s.* types belong to the
# `k8s` provider, whose configuration carries three of those nulls.
# google.client_config and google.secret_manager_secret_version are data
# sources: no type_provider.

type_provider("google.compute_subnetwork", "google")
type_provider("google.compute_network_peering", "google")
type_provider("google.compute_address", "google")
type_provider("google.monitoring_dashboard", "google")
type_provider("google.container_cluster", "google")
type_provider("google.container_node_pool", "google")
type_provider(k8s.namespace, "k8s")
type_provider(k8s.deployment, "k8s")
type_provider(k8s.secret, "k8s")

type_attr("google.compute_subnetwork", "id", "string", ["computed", "id"])
type_attr("google.compute_network_peering", "id", "string", ["computed", "id"])
type_attr("google.compute_address", "id", "string", ["computed", "id"])
type_attr("google.monitoring_dashboard", "id", "string", ["computed", "id"])
type_attr("google.container_cluster", "id", "string", ["computed", "id"])
type_attr("google.container_node_pool", "id", "string", ["computed", "id"])

# What points at another resource takes it, and gets its id at Apply (R-43);
# the bridged module keeps its Terraform names.
type_attr("google.container_cluster", "subnetwork_id", "ref(google.compute_subnetwork)", [])
type_attr("google.compute_address", "subnetwork_id", "ref(google.compute_subnetwork)", [])
type_attr("google.container_node_pool", "cluster", "ref(google.container_cluster)", [])

type_attr(k8s.namespace, "id", "string", ["computed", "id"])
type_attr(k8s.namespace, "uid", "string", ["computed", "id"])
type_attr(k8s.deployment, "id", "string", ["computed", "id"])
type_attr(k8s.deployment, "uid", "string", ["computed", "id"])
type_attr(k8s.secret, "id", "string", ["computed", "id"])
type_attr(k8s.secret, "uid", "string", ["computed", "id"])
type_attr(k8s.secret, "data", "map", ["sensitive"])

type_attr("google.container_cluster", "endpoint", "string", ["computed"])
type_attr("google.container_cluster", "ca_certificate", "string", ["computed"])
type_attr("google.container_cluster", "zones", "list", ["computed"])

type_attr(google.client_config, "access_token", "string", ["computed", "sensitive"])
type_attr(google.secret_manager_secret_version, "secret_data", "string", ["computed", "sensitive"])

type_mint("google.container_cluster", "endpoint", "https://{name}.gke.fake")
# The zones a cluster lands in are the node locations it was configured with.
type_mint("google.container_cluster", "zones", "{doc:node_locations}")

# Descriptions (`type_doc(Type, Path, Text)`; the path "" is the type's),
# for the paths the examples write: the language server's hover and
# completion show them.
type_doc(
  "google.container_cluster",
  "",
  "A GKE cluster, as the terraform-mi-gke module creates it.",
)
type_doc(
  "google.container_cluster",
  "cluster_type",
  "The module's cluster flavour, such as \"autopilot-private\".",
)
type_doc("google.container_cluster", "env", "The environment the cluster serves.")
type_doc(
  "google.container_cluster",
  "project_id",
  "The id of the Google Cloud project the cluster is in.",
)
type_doc(
  "google.container_cluster",
  "project_name",
  "The project's name, the prefix of the cluster's resources.",
)
type_doc(
  "google.container_cluster",
  "name",
  "The cluster's name, unique in the project and location.",
)
type_doc("google.container_cluster", "network", "The VPC network the cluster attaches to.")
type_doc(
