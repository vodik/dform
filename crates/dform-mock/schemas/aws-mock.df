# Mock AWS provider in the shape of the Terraform AWS provider (v5 schema),
# thirteen resource types, written by hand from the provider's schema. A type is
# Terraform's under the provider's name (`aws_vpc` is `aws.vpc`, R-36); the
# data source aws.availability_zone, declared below (`extern_decl`, R-106),
# is answered from aws-mock.externs.df. It
# exists to make two shapes concrete for the phase 2 decisions:
#
#   - Optional+Computed (optional_computed): the program may set the attribute;
#     when it does not, AWS picks it at Apply (an instance's subnet_id and
#     availability_zone, a security group's vpc_id, a bucket's name).
#   - keyless sets (type set, no type_list_key): security group ingress and
#     egress, route table routes, vpc_security_group_ids. Element order is
#     not a change; an element has no identity but its whole content.
#   - force_new: changing a vpc's or subnet's cidr_block, a subnet's zone or a
#     bucket's name replaces the object, as the provider's RequiresReplace does.
#   - type_replace: an instance's replacement is created first; a bucket's
#     name is global, so the old bucket is destroyed first.
#   - name_like: a name_prefix names the object in the account, as `name`
#     and `bucket` do; a keyed stack's deployments must not share one.
#
# Every type has tags (optional) and tags_all (computed: tags merged with the
# provider's default_tags). ids and arns are computed; ids are fresh. An
# attribute that holds another object's id keeps the Terraform name and is
# typed `ref(T)`: the program gives it the resource (`vpc_id = main`), and
# the provider its id (R-43).

# The data source: a program reads it with no `extern` line (R-106). Its
# index is a stable ordinal of the names the provider defines.
extern_decl("aws.availability_zone", "+state, -name, -index: int")

# aws.vpc
type_provider("aws.vpc", "aws")
type_attr("aws.vpc", "id", "string", ["computed", "id"])
type_mint("aws.vpc", "id", "vpc-{hash}")
type_attr("aws.vpc", "arn", "string", ["computed"])
type_mint("aws.vpc", "arn", "arn:aws:ec2:us-east-1:123456789012:vpc/{name}")
type_attr("aws.vpc", "tags", "map", [])
type_attr("aws.vpc", "tags_all", "map", ["computed"])
type_attr("aws.vpc", "cidr_block", "string", ["optional_computed", "force_new"])
type_mint("aws.vpc", "cidr_block", "10.0.0.0/16")
type_attr("aws.vpc", "instance_tenancy", "string", [])
type_attr("aws.vpc", "enable_dns_support", "bool", [])
type_attr("aws.vpc", "enable_dns_hostnames", "bool", ["optional_computed"])
type_mint("aws.vpc", "enable_dns_hostnames", false)
type_attr("aws.vpc", "ipv6_cidr_block", "string", ["optional_computed"])
type_mint("aws.vpc", "ipv6_cidr_block", "")
type_attr("aws.vpc", "default_security_group_id", "string", ["computed"])
type_mint("aws.vpc", "default_security_group_id", "sg-{hash}")
type_attr("aws.vpc", "default_route_table_id", "string", ["computed"])
type_mint("aws.vpc", "default_route_table_id", "rtb-{hash}")
type_attr("aws.vpc", "main_route_table_id", "string", ["computed"])
type_mint("aws.vpc", "main_route_table_id", "rtb-{hash}")
type_attr("aws.vpc", "default_network_acl_id", "string", ["computed"])
type_mint("aws.vpc", "default_network_acl_id", "acl-{hash}")
type_attr("aws.vpc", "dhcp_options_id", "string", ["computed"])
type_mint("aws.vpc", "dhcp_options_id", "dopt-{hash}")
type_attr("aws.vpc", "owner_id", "string", ["computed"])
type_mint("aws.vpc", "owner_id", "123456789012")

