# The OVHcloud provider's schema (`dform-provider-ovh`, R-44): Public
# Cloud instances, SSH keys, S3 containers, users, volumes and private
# networks of one project, and DNS records of a zone. Each type is an
# object the API gives an identity; a relationship whose state lives on
# another object (a volume's attachment, an instance's networks, a user's
# S3 credentials) is an attribute of that object.
#
#   type_attr(Type, Path, Ty, Flags).   Flags: required computed id sensitive
#                                       nullable optional_computed force_new
#   type_provider(Type, Provider).
#   type_replace(Type, Order).          create_first, destroy_first or either
#   type_lookup(Type, Attrs).           what a Create that timed out is found by
#
# An object's identity is its `id`: state holds it, and an update goes to
# it. An attribute is `force_new` only where the API cannot change it on
# the id (R-195). What a Create that timed out is found by, the content
# its lookup matches, is `type_lookup`: neither identity nor `force_new`.
# A record's lookup is its zone, subdomain, type and target, and its
# subdomain, target and ttl change in place. An instance's lookup is its
# name in its region, an SSH key's its name, so a replacement deletes
# the old one first.

# The data sources (R-106): a program reads them with no `extern` line.
# `ovh.region` the project's regions, `ovh.flavor` a region's available
# flavors (RAM and disk as the API counts them), `ovh.image` a region's
# active images, the distribution the first word of the name.
extern_decl("ovh.region", "+project, -name, -status")
extern_decl("ovh.flavor", "+region, -name, -vcpus: int, -ram: bytes, -disk: bytes")
extern_decl("ovh.image", "+region, -name, -id, -distribution")

type_provider("ovh.instance", "ovh")
type_provider("ovh.ssh_key", "ovh")
type_provider("ovh.domain_record", "ovh")

# The API's update of an instance (`PUT .../instance/{id}`) takes its
# name alone. Its flavor (a resize), its networks (an interface attached
# or detached) and its image (a reinstall, which erases its disk) change
# by calls of their own that this provider does not make yet; its region,
# SSH key and user data are fixed at its creation.
type_attr("ovh.instance", "id", "string", ["computed", "id"])
type_attr("ovh.instance", "name", "string", ["required"])
type_attr("ovh.instance", "region", "string", ["required", "force_new"])
type_attr("ovh.instance", "flavor", "string", ["required", "force_new"])
type_attr("ovh.instance", "image", "string", ["required", "force_new"])
type_attr("ovh.instance", "ssh_key", "ref(ovh.ssh_key)", ["force_new"])
# Write-only: the API never answers it; state keeps the digest of what was
# applied, and a different one replaces the instance (R-106).
type_attr("ovh.instance", "user_data", "string", ["sensitive", "force_new", "write_only"])
# Its private networks: made on them, it has an interface on each.
type_attr("ovh.instance", "networks", "set(ref(ovh.network))", ["force_new"])
type_attr("ovh.instance", "public_ip", "ip", ["computed"])
type_attr("ovh.instance", "private_ip", "ip", ["computed", "nullable"])
type_attr("ovh.instance", "private_ips", "map(ip)", ["computed"])
type_attr("ovh.instance", "status", "string", ["computed"])
type_replace("ovh.instance", "destroy_first")
type_lookup("ovh.instance", ["name", "region"])

# The API has no update call for an SSH key.
type_attr("ovh.ssh_key", "id", "string", ["computed", "id"])
type_attr("ovh.ssh_key", "name", "string", ["required", "force_new"])
type_attr("ovh.ssh_key", "public_key", "string", ["required", "force_new"])
type_replace("ovh.ssh_key", "destroy_first")
type_lookup("ovh.ssh_key", ["name"])

# The API's update of a record (`PUT /domain/zone/{zone}/record/{id}`)
# takes its subdomain, target and ttl; its zone and type are fixed.
type_attr("ovh.domain_record", "id", "string", ["computed", "id"])
type_attr("ovh.domain_record", "zone", "string", ["required", "force_new"])
type_attr("ovh.domain_record", "subdomain", "string", [])
type_attr(
  "ovh.domain_record",
  "type",
  "enum(A, AAAA, CNAME, TXT, SRV, MX)",
  ["required", "force_new"],
)
type_attr("ovh.domain_record", "target", "string", ["required"])
type_attr("ovh.domain_record", "ttl", "int", ["optional_computed"])
type_replace("ovh.domain_record", "either")
type_lookup("ovh.domain_record", ["zone", "subdomain", "type", "target"])

# An S3 container is found by its region and name, which S3 never
# changes; only its versioning changes in place.
type_provider("ovh.storage_container", "ovh")
type_attr("ovh.storage_container", "id", "string", ["computed", "id"])
type_attr("ovh.storage_container", "region", "string", ["required", "force_new"])
type_attr("ovh.storage_container", "name", "string", ["required", "force_new"])
type_attr("ovh.storage_container", "versioning", "bool", ["optional_computed"])
type_attr(
  "ovh.storage_container",
  "owner",
  "ref(ovh.cloud_project_user)",
  ["optional_computed", "force_new"],
)
type_attr("ovh.storage_container", "virtual_host", "string", ["computed"])
type_replace("ovh.storage_container", "destroy_first")
type_lookup("ovh.storage_container", ["region", "name"])

# A user is found by its description (the API makes up its username),
# which the API has no call to change; its roles change in place. Its S3 secret is held: the API keeps it, and
# Reveal reads it there.
type_provider("ovh.cloud_project_user", "ovh")
type_attr("ovh.cloud_project_user", "id", "string", ["computed", "id"])
type_attr("ovh.cloud_project_user", "description", "string", ["required", "force_new"])
type_attr(
  "ovh.cloud_project_user",
  "roles",
  "set(enum(administrator, ai_training_operator, ai_training_read, authentication, backup_operator, compute_operator, image_operator, infrastructure_supervisor, key-manager_operator, key-manager_read, load-balancer_operator, network_operator, network_security_operator, objectstore_operator, quantum_operator, quantum_reader, share_operator, volume_operator))",
  ["required"],
)
type_attr("ovh.cloud_project_user", "username", "string", ["computed"])
type_attr("ovh.cloud_project_user", "status", "string", ["computed"])
type_attr("ovh.cloud_project_user", "s3_access_key", "string", ["computed", "nullable"])
type_attr("ovh.cloud_project_user", "s3_secret_key", "string", ["computed", "sensitive"])
type_replace("ovh.cloud_project_user", "destroy_first")
type_lookup("ovh.cloud_project_user", ["description"])

# A volume is found by its name in its region; it grows in place (a smaller
# size replaces it, which Plan says), its name, description and instance
# change in place. Its image and snapshot are write-only: the API never
# answers them, and dform keeps their digests (R-106).
type_provider("ovh.volume", "ovh")
type_attr("ovh.volume", "id", "string", ["computed", "id"])
type_attr("ovh.volume", "name", "string", ["required"])
type_attr("ovh.volume", "region", "string", ["required", "force_new"])
type_attr("ovh.volume", "size", "bytes(gib)", ["required"])
type_attr(
  "ovh.volume",
  "type",
  "enum(classic, classic-luks, high-speed, high-speed-luks, high-speed-gen2, high-speed-gen2-luks)",
  ["optional_computed", "force_new"],
)
type_attr("ovh.volume", "description", "string", ["optional_computed"])
type_attr("ovh.volume", "image", "string", ["force_new", "write_only"])
type_attr("ovh.volume", "snapshot", "string", ["force_new", "write_only"])
type_attr("ovh.volume", "instance", "ref(ovh.instance)", [])
type_attr("ovh.volume", "status", "string", ["computed"])
type_replace("ovh.volume", "destroy_first")
type_lookup("ovh.volume", ["name", "region"])

# A private network is found by its name; it is added to regions in place,
# and leaves none (Plan replaces it). Its vRack is the account's.
type_provider("ovh.network", "ovh")
type_attr("ovh.network", "id", "string", ["computed", "id"])
type_attr("ovh.network", "name", "string", ["required"])
type_attr("ovh.network", "vlan_id", "int", ["optional_computed", "force_new"])
type_attr("ovh.network", "regions", "set(string)", ["optional_computed"])
type_attr("ovh.network", "status", "string", ["computed"])
type_attr("ovh.network", "regions_status", "map(string)", ["computed"])
type_replace("ovh.network", "destroy_first")
type_lookup("ovh.network", ["name"])

# A subnet is found by its network, region and range; nothing of it
# changes in place (the API has no update call for one). Its pool is the DHCP pool, its first and last address (the
# API's `start` and `end`); when not set, Plan gives it the range's usable
# hosts, as the OVH console does.
type_provider("ovh.subnet", "ovh")
type_attr("ovh.subnet", "id", "string", ["computed", "id"])
type_attr("ovh.subnet", "network", "ref(ovh.network)", ["required", "force_new"])
type_attr("ovh.subnet", "region", "string", ["required", "force_new"])
type_attr("ovh.subnet", "range", "inet", ["required", "force_new"])
type_attr("ovh.subnet", "pool", "range(ip)", ["optional_computed", "force_new"])
type_attr("ovh.subnet", "dhcp", "bool", ["optional_computed", "force_new"])
type_attr("ovh.subnet", "no_gateway", "bool", ["optional_computed", "force_new"])
type_attr("ovh.subnet", "gateway_ip", "ip", ["computed", "nullable"])
type_replace("ovh.subnet", "destroy_first")
type_lookup("ovh.subnet", ["network", "region", "range"])

type_doc("ovh.instance", "", "A Public Cloud instance of the project.")
type_doc(
  "ovh.instance",
  "name",
  "The instance's name, unique in the project: what a Create that timed out is found by. Changed in place.",
)
type_doc(
  "ovh.instance",
  "region",
  "The region it runs in (`ca-east-tor`, `BHS5`). Changing it replaces the instance.",
)
type_doc(
  "ovh.instance",
  "flavor",
  "The flavor's name (`b2-7`, `d2-2`). Changing it replaces the instance.",
)
type_doc(
  "ovh.instance",
  "image",
  "The image's name in the region (`Ubuntu 24.04`). Changing it replaces the instance.",
)
type_doc(
  "ovh.instance",
  "ssh_key",
  "The SSH key installed for the image's default user. Changing it replaces the instance.",
)
type_doc(
  "ovh.instance",
  "user_data",
  "The cloud-init document the instance boots with. Changing it replaces the instance.",
)
type_doc("ovh.instance", "public_ip", "The instance's public IPv4 address, once it has one.")
type_doc(
  "ovh.instance",
  "networks",
  "The private networks it is on (`networks = [lab]`), each in its region and with a subnet there; the public network too. Changing them replaces the instance.",
)
type_doc("ovh.instance", "private_ip", "Its address on a private network, if it is on one.")
type_doc(
  "ovh.instance",
  "private_ips",
  "Its address on each private network, by the network's id (`server.private_ips[lab.id]`).",
)
type_doc("ovh.instance", "status", "ACTIVE once it runs; BUILD while it is made.")
type_doc("ovh.ssh_key", "", "An SSH public key of the project, for its instances.")
type_doc("ovh.ssh_key", "name", "The key's name, unique in the project.")
type_doc("ovh.ssh_key", "public_key", "The OpenSSH public key (`ssh-ed25519 AAAA...`).")
type_doc("ovh.domain_record", "", "A record of a DNS zone OVH hosts.")
type_doc("ovh.domain_record", "zone", "The zone (`example.com`). Changing it replaces the record.")
type_doc(
  "ovh.domain_record",
  "subdomain",
  "The name under the zone (`www`); none for the zone's apex. Changed in place.",
)
type_doc(
  "ovh.domain_record",
  "type",
  "A, AAAA, CNAME, TXT, SRV or MX. Changing it replaces the record.",
)
type_doc("ovh.domain_record", "target", "The record's value. Changed in place.")
type_doc(
  "ovh.domain_record",
  "ttl",
  "Seconds a resolver keeps it; 0, the zone's default, when not set. Changed in place.",
)
type_doc(
  "ovh.storage_container",
  "",
  "An S3 object storage container of a region (the API's `/region/{r}/storage`).",
)
type_doc(
  "ovh.storage_container",
  "region",
  "The region it is in (`BHS`, `ca-east-tor`). Changing it replaces the container.",
)
type_doc(
  "ovh.storage_container",
  "name",
  "The container's name, unique in the region. Changing it replaces the container.",
)
type_doc(
  "ovh.storage_container",
  "versioning",
  "Whether objects keep their versions; turned off again it is suspended. Changed in place.",
)
type_doc(
  "ovh.storage_container",
  "owner",
  "The user that owns it (`owner = backup`); the project's first S3 user when not set. Changing it replaces the container.",
)
type_doc(
  "ovh.storage_container",
  "virtual_host",
  "Its S3 virtual host (`NAME.s3.REGION.io.cloud.ovh.net`).",
)
type_doc(
  "ovh.cloud_project_user",
  "",
  "An OpenStack user of the project, with an S3 credential (the API's `/user`).",
)
type_doc(
  "ovh.cloud_project_user",
  "description",
  "What the user is for, unique in the project: what a Create that timed out is found by. Changing it replaces the user.",
)
type_doc(
  "ovh.cloud_project_user",
  "roles",
  "Its OpenStack roles (`objectstore_operator`, `compute_operator`, ...). Changed in place.",
)
type_doc("ovh.cloud_project_user", "username", "The name the API made for it (`user-Xk3pQ9`).")
type_doc(
  "ovh.cloud_project_user",
  "status",
  "`ok` once it can be used; `creating` while it is made.",
)
type_doc(
  "ovh.cloud_project_user",
  "s3_access_key",
  "The access key of its S3 credential, made with the user.",
)
type_doc(
  "ovh.cloud_project_user",
  "s3_secret_key",
  "The S3 credential's secret. The API keeps it; dform has only its label, and a provider configured with it reads it from the API.",
)
type_doc("ovh.volume", "", "A block storage volume of the project (the API's `/volume`).")
type_doc(
  "ovh.volume",
  "name",
  "The volume's name, unique in its region: what a Create that timed out is found by. Changed in place.",
)
type_doc("ovh.volume", "region", "The region it is in. Changing it replaces the volume.")
type_doc(
  "ovh.volume",
  "size",
  "Its size, in whole GiB (`50Gi`). It grows in place; a smaller one replaces the volume.",
)
type_doc(
  "ovh.volume",
  "type",
  "`classic`, `high-speed` or `high-speed-gen2`, `-luks` for an encrypted one; `classic` when not set. Changing it replaces the volume.",
)
type_doc("ovh.volume", "description", "What it is for. Changed in place.")
type_doc(
  "ovh.volume",
  "image",
  "The image's name in the region, for a bootable volume. Changing it replaces the volume.",
)
type_doc(
  "ovh.volume",
  "snapshot",
  "The id of the snapshot it is made from. Changing it replaces the volume.",
)
type_doc(
  "ovh.volume",
  "instance",
  "The instance it is attached to (`instance = server`), in its region. Set, it is attached; cleared, detached; changed, moved.",
)
type_doc(
  "ovh.volume",
  "status",
  "`available`, or `in-use` attached; `creating`, `attaching`, `detaching` while it changes.",
)
type_doc(
  "ovh.network",
  "",
  "A private network of the project: a VLAN of the vRack the project is on (the API's `/network/private`). The vRack is the account's, attached to the project in the OVH control panel, outside dform; a project without one is refused at plan.",
)
type_doc(
  "ovh.network",
  "name",
  "The network's name, unique in the project: what a Create that timed out is found by. Changed in place.",
)
type_doc(
  "ovh.network",
  "vlan_id",
  "Its VLAN in the vRack, 0 to 4000; 0 when not set. Changing it replaces the network.",
)
type_doc(
  "ovh.network",
  "regions",
  "The regions it is in; every region of the project when not set. One added is added in place; one left replaces the network.",
)
type_doc("ovh.network", "status", "ACTIVE once it can be used; BUILDING while it is made.")
type_doc("ovh.network", "regions_status", "Each region's status, by region.")
type_doc(
  "ovh.subnet",
  "",
  "A subnet of a private network in one region (the API's `/network/private/{id}/subnet`). Changing anything replaces it.",
)
type_doc("ovh.subnet", "network", "The private network it is of (`network = lab`).")
type_doc("ovh.subnet", "region", "The region it is in, one of its network's.")
type_doc(
  "ovh.subnet",
  "range",
  "The network's range (`10.0.0.0/24`), what the API calls `network`.",
)
type_doc(
  "ovh.subnet",
  "pool",
  "The addresses instances are given, both ends in it (`10.42.0.2..=10.42.0.254`); the range's hosts after its gateway when not set. Changing it replaces the subnet.",
)
type_doc("ovh.subnet", "dhcp", "Whether instances get their address by DHCP; not when not set.")
type_doc(
  "ovh.subnet",
  "no_gateway",
  "No default gateway on the subnet; it has one (its range's first address) when not set.",
)
type_doc("ovh.subnet", "gateway_ip", "The subnet's gateway, if it has one.")
