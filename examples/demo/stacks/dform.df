# dform demo: component-scoped resources + settings + IAM policy assembly.
#
# To run it, from this directory: README.md.

# The stack is this file, dform, keyed by env: dform[env=prod]'s state is dform.state/dform/env=prod/.
#| The deployment's environment, the stack's key: `dform plan dform env=prod`
#| names the deployment, and without one the default is the deployment.
#| owner: platform
key env: environment = "staging"
input cidrs { main: string = "10.50.0.0/16", peer: string = "10.60.0.0/16" }
data("zone", "us-test-1a")
data("zone", "us-test-1b")

# A fact with a condition: it holds in prod only.
iam_need("app", "audit.write", "audit-log") where env == "prod"
# A component's need is its output, wired here.
iam_need("app", n.action, n.resource) where n = database.iam_need
iam_need("app", n.action, n.resource) where n = kubernetes.iam_need

# Settings (branch as data): each environment's config/dform/{env}.yaml
# gives the inputs it names a leaf at a time (`cidrs.main`,
# `database.multi_az`), at the normal rank, over the inputs' defaults;
# the modules used below take theirs from this block but in prod. A CIDR
# is text in the document, made an inet where it is used.
set from yaml("config/dform/${env}.yaml")
set {
  database.backup_days = 3
  database.multi_az = false
  kubernetes.private_api = false
  kubernetes.nodepool_min = 1
  kubernetes.nodepool_max = 3
} where env != "prod"

# The provider (the mock's built-in fake schema). The stack's operational
# settings are dform.toml's [stacks.dform]: isolated, each env in its own
# account, so identity's fixed names do not collide.

provider fake
#| The environments: an alias, the enum wherever it is written.
type environment = enum("dev", "staging", "prod")

# The modules every stack uses: the files baseline.df and stdlib_net.df,
# by their paths from the project root. Their rules and denies run over
# what this stack sees.
use baseline
use stdlib_net

# Copies of a component (Terraform module-like): network.df's `vpc`, once
# per network. Inputs are declared by the component; each `k = v` here is
# a contribution to one.
instance network.vpc main { vpc_net = inet(cidrs.main) }

# Dev is small: one network, no database, no cluster.
instance network.vpc peer { vpc_net = inet(cidrs.peer) } where env != "dev"

# A module is imported once, its inputs bound by its block, rows included
# (database.df's resources are `database/db`): main's private subnets.
# Its inputs are the stack's `set`s (`database.backup_days`, ..): the block
# above and, in prod, config/dform/prod.yaml.
use database {
  subnet(s) where main.private_subnet(s)
} where env != "dev"

# So are the cluster's, `kubernetes.private_api` and its node pool's
# bounds; dev has neither, which the `where` says and the `set`s need
# not.
use kubernetes {
  subnet(s) where main.private_subnet(s)
} where env != "dev"

use identity

#| VPC peering intent: define edges between network instances.
vpc_peer_inst("main", "peer")

#| Each network instance outputs its vpc's address; an edge's pair is the
#| two instances' vpcs, joined on the instance names.
vpc_peer_pair(ia, ib, a, b) where {
  vpc_peer_inst(ia, ib)
  a = network.vpc[ia].vpc
  b = network.vpc[ib].vpc
}
vpc_peer(a, b) where vpc_peer_pair(_, _, a, b)

#| A peering resource per declared peering edge.
resource net.vpc_peering "peer-${ia}-${ib}" {
  # Both ends must exist in this environment.
  requester_vpc = a
  accepter_vpc = b
} where vpc_peer_pair(ia, ib, a, b), a in net.vpc, b in net.vpc

#| Demo: allocate an IP from the main VPC.
resource compute.vm bastion { private_ip = inet.host(inet(cidrs.main), 20) }

# Policy, over every resource of a type (a copy's resources included).
deny "prod db must be multi_az" where env == "prod", pg in db.postgres, not pg.multi_az

deny "prod k8s must have private api" where env == "prod", c in k8s.cluster, not c.private_api

# The denies are the tests: `dform test dform` evaluates the program for
# each env against an empty mock world, and each deny must hold in every
# one.
deny "prod peers the two vpcs" where env == "prod", not "peer-main-peer" in net.vpc_peering
deny "prod keeps 14 days of db backups" where {
  env == "prod"
  not db.postgres["database.db"].backup_days == 14
}
deny "dev has no database" where env == "dev", _ in db.postgres
deny "dev has no peer network" where env == "dev", "peer.vpc" in net.vpc
