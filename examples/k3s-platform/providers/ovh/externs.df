# The account's answers to the OVH tables, as the mock gives them: the
# zone it hosts and the flavors of its region.

ovh.zone("example.com", "example.com", ["dns200.anycast.me", "ns200.anycast.me"])

ovh.flavor("BHS5", "d2-2", 1, 2Gi, 25Gi)
ovh.flavor("BHS5", "b2-7", 2, 7Gi, 50Gi)
ovh.flavor("BHS5", "b2-15", 4, 15Gi, 100Gi)
