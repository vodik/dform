# Demo: adopting an existing resource from inventory.
#
# Runs from a clean clone, no setup needed:
#   cargo run -- --file examples/adopt_demo.df --inventory examples/world/inventory.json plan --set env=prod

edition 2026.

input env: enum(staging, prod) = staging.

settings prod {
  network.vpc_cidr = inet("10.20.0.0/16")
}.

import "../modules/network.df".

instance network main {
  vpc_net = VpcCidr
} :-
  env(Env),
  setting(Env, .network.vpc_cidr, VpcCidr).

# Adopt the VPC from inventory, but manage it under the local name `network.main::vpc`.
adopt(net.vpc, network.main/vpc, "existing-prod-vpc") :-
  env(prod),
  cloud_exists(net.vpc, "existing-prod-vpc").

# Example: use discovered inventory values directly in config.
arg(net.vpc, network.main/vpc, .adopted_id, cloud_ref(net.vpc, "existing-prod-vpc", .id)) :-
  env(prod).

# Keep the existing owner tag stable (avoids a "remove tag" diff on adopt).
arg(net.vpc, network.main/vpc, .tags.owner, cloud_ref(net.vpc, "existing-prod-vpc", .tags.owner)) :-
  env(prod).

# Also copy it into a separate attribute to demonstrate dotted path lookup.
arg(net.vpc, network.main/vpc, .owner_tag, cloud_ref(net.vpc, "existing-prod-vpc", .tags.owner)) :-
  env(prod).
