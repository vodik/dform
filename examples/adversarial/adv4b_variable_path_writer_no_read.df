# adv4b: the variable-path writer that reads no attribute. Lands at
# (arg, *, *), above every attr reader, and stratifies.
override(net.vpc, main, tags, { team: x }).

resource net.vpc main {
  cidr = inet("10.0.0.0/16"),
  tags = { env: dev }
}.

arg(T, N, P, V) :-
  override(T, N, P, V),
  want(T, N).

deny("vpc without cidr", { vpc: N }) :-
  want(net.vpc, N),
  not arg(net.vpc, N, cidr, inet("10.0.0.0/16")).
