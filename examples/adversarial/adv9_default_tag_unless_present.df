# adv9: D's "add a default tag unless the resource already has one" idiom,
# written against the merged attr. Reads (attr, *, tags), writes
# (arg, *, tags): a self-loop. E's answer is @default rank, not this.
resource net.vpc main {
  cidr = inet("10.0.0.0/16"),
  tags = { env: dev }
}.

arg_add(T, N, "tags", { team: platform }) :-
  want(T, N),
  not arg(T, N, tags, { team: platform }).
