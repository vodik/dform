# adv4: a variable-path writer (arg, *, *) that also reads an attribute.
# E: "a policy that writes variable type and path reads no attribute".
# This one does, so it must be rejected.

edition 2026.

override(net.vpc, main, .tags, { team: x }).

resource net.vpc main {
  cidr = inet("10.0.0.0/16"),
  tags = { env: dev }
}.

arg(T, N, P, V) :-
  override(T, N, P, V),
  want(T, N),
  arg(T, N, .cidr, _C).
