# C's two-phase GKE / kubernetes stack (E §7.4), in the current syntax.
# Run with the gke mock schema, which makes the cluster's zones, endpoint and
# ca open nulls until the cluster exists. Two ticks.
#
# E §2.7 worked example item 6, both branches: the cluster is placed in
# `zones` zones, two by default. With one (`--set zones=1`) its zones come
# back with one element, so at the boundary the two-zones deny derives and
# apply stops after tick 1, before the nodepools and the kubernetes objects.
# To run it, from this directory: README.md.

input env: enum("dev", "stg", "prod") = "dev"
# How many zones the cluster is placed in.
input zones: int = 2 check zones >= 1
# The project and the cluster's networks, dev's below.
input gcp { project_id: string, project_name: string, region: string, network_name: string }
input gke { control_plane_cidr: inet, subnet_cidr: inet }

use gke

zone_at(1, "us-east1-b")
zone_at(2, "us-east1-c")

set {
  gcp.project_id = "renfry-dev-973682"
  gcp.project_name = "renfry-dev"
  gcp.region = "us-east1"
  gcp.network_name = "renfry-dev-network"
  gke = { control_plane_cidr: inet("172.16.3.96/28"), subnet_cidr: inet("10.141.76.0/22") }
} where env == "dev"

project(
  gcp.project_id,
  gcp.project_name,
  gcp.region,
  "projects/${gcp.project_id}/global/networks/${gcp.network_name}",
)

resource google.compute_subnetwork gke_subnet {
  project = id
  region
  network = net_id
  name = "${name}-gke-subnet"
  ip_cidr_range = gke.subnet_cidr
} where project(id, name, region, net_id)

# Carries a fresh null (subnetwork_id) and is still definite.
resource google.compute_address static_ip {
  project = id
  region
  name = "pngu-grpc"
  subnetwork_id = gke_subnet
} where project(id, _, region, _)

resource google.container_cluster pngu {
  env
  project_id = id
  name = "${name}-gke"
  network_id = net_id
  subnetwork_id = gke_subnet
  master_control_plane_cidr = gke.control_plane_cidr
  node_locations = [ z | zone_at(i, z), i <= zones ]
  deletion_protection = true
} where project(id, name, _, net_id)

# Provider configured from phase-1 nulls (two open, one secret).
provider_config(
  "k8s",
  {
    host: google.container_cluster["pngu"].endpoint,
    ca: google.container_cluster["pngu"].ca_certificate,
    token: google.client_config["current"].access_token,
  },
)

resource k8s.namespace pngu { name = "pngu" }

# A read in the clause is an attr join (the value now), not a reference.
resource k8s.deployment api {
  namespace = ns
  image = "gcr.io/renfry/api:1.42"
  replicas = 3
} where ns = k8s.namespace["pngu"].name

resource k8s.secret db_credentials {
  namespace = ns
  data = { password: google.secret_manager_secret_version["db_pw"].secret_data }
} where ns = k8s.namespace["pngu"].name

# One nodepool per zone: member over an open null is a content position.
resource google.container_node_pool "np-${z}" {
  cluster = google.container_cluster["pngu"]
  zone = z
  min = 1
  max = 3
} where z in google.container_cluster["pngu"].zones

zone_count(n) where n = count(z), z in google.container_cluster["pngu"].zones

deny "cluster must be in at least two zones" { cluster: "pngu" } where {
  "pngu" in google.container_cluster
  zone_count(n)
  n < 2
}

# A policy that has nothing to do with zones. Under coarse Rule 3 it would be
# undetermined anyway (a `want` rule is stuck), which is the spurious case;
# per key it is decided now, and holds.
deny "cluster must not be deletable" { cluster: c } where {
  c in google.container_cluster
  not c.deletion_protection
}
