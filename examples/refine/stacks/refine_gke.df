# gke_two_phase.df with refinements (E §4.1 case 4, DR-13): the cluster's
# zones are an open null until the cluster exists, so the refinement on
# them is deferred at plan time ("refinement on ?gke_cluster/pngu#zones
# deferred"). Tick 1 creates the cluster in the zones its node_locations
# name; the boundary resolves the zones and the refinement (len_ge(3)) is
# checked against them. Three zones hold; two (`--set zones=2`) do not,
# and apply stops after tick 1, before the nodepools and the kubernetes
# objects. To run it, from this directory: README.md.
#
# The settings refinements are checked at compile time against the literal
# CIDRs (they hold), and again in the cell.
#
# C's two-phase GKE / kubernetes stack (E §7.4), in the current syntax, with
# the gke mock schema, which makes the cluster's zones, endpoint and ca open
# nulls until the cluster exists.

edition 2026

input env: enum("dev", "stg", "prod") = "dev"
# How many zones the cluster is placed in: two is fewer than the
# refinement on its zones allows.
input zones: int = 3 check zones >= 1

provider gke {}

zone_at(1, "us-east1-b")
zone_at(2, "us-east1-c")
zone_at(3, "us-east1-d")

settings dev {
  project_id = "renfry-dev-973682"
  project_name = "renfry-dev"
  region = "us-east1"
  network_name = "renfry-dev-network"
  gke = {
    control_plane_cidr: inet("172.16.3.96/28"),
    subnet_cidr: inet("10.141.76.0/22")
  }
}

let cfg = settings[env]

project(cfg.project_id, cfg.project_name, cfg.region,
  "projects/${cfg.project_id}/global/networks/${cfg.network_name}")

resource google_compute_subnetwork gke_subnet {
  project = id
  region = region
  network = net_id
  name = "${name}-gke-subnet"
  ip_cidr_range = cfg.gke.subnet_cidr
} where project(id, name, region, net_id)

# Carries a fresh null (subnetwork_id) and is still definite.
resource google_compute_address static_ip {
  project = id
  region = region
  name = "pngu-grpc"
  subnetwork_id = gke_subnet.id
} where project(id, _, region, _)

resource gke_cluster pngu {
  env = env
  project_id = id
  name = "${name}-gke"
  network_id = net_id
  subnetwork_id = gke_subnet.id
  master_control_plane_cidr = cfg.gke.control_plane_cidr
  node_locations = [ z | zone_at(i, z), i <= zones ]
  deletion_protection = true
} where project(id, name, _, net_id)

# Provider configured from phase-1 nulls (two open, one secret).
provider_config("kubernetes", {
  host: gke_cluster["pngu"].endpoint,
  ca: gke_cluster["pngu"].ca_certificate,
  token: google.client_config["current"].access_token
})

resource k8s.namespace pngu {
  name = "pngu"
}

# A read in the clause is an attr join (the value now), not a reference.
resource k8s.deployment api {
  namespace = ns
  image = "gcr.io/renfry/api:1.42"
  replicas = 3
} where ns = k8s.namespace["pngu"].name

resource k8s.secret db_credentials {
  namespace = ns
  data = { password: google.secret_manager_secret_version["db_pw"].secret_data }
} where ns = k8s.namespace["pngu"].name

# One nodepool per zone: member over an open null is a content position.
resource gke_nodepool "np-${z}" {
  cluster = gke_cluster["pngu"].id
  zone = z
  min = 1
  max = 3
} where z in gke_cluster["pngu"].zones

zone_count(count(z)) where z in gke_cluster["pngu"].zones

deny "cluster must be in at least two zones" { cluster: "pngu" } where {
  "pngu" in gke_cluster
  zone_count(n)
  n < 2
}

# A policy that has nothing to do with zones. Under coarse Rule 3 it would be
# undetermined anyway (a `want` rule is stuck), which is the spurious case;
# per key it is decided now, and holds.
deny "cluster must not be deletable" { cluster: c } where {
  c in gke_cluster
  not c.deletion_protection
}

# Refinements (E §7.4's settings type, and one the cluster meets only in
# three zones).
type settings {
  gke: {
    control_plane_cidr: inet check inet.prefix_len(control_plane_cidr) == 28
    subnet_cidr: inet check inet.prefix_len(subnet_cidr) == 22
  }
}

type gke_cluster {
  zones: list(string) check len(zones) >= 3
}
