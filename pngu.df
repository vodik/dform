# pngu.df
#
# dform representation of ~/src/movableink/pngu/terraform.
#
# Usage:
#   cargo run -- --file pngu.df plan
#   cargo run -- --file pngu.df plan --set env=stg
#   cargo run -- --file pngu.df plan --set env=prod
#
# Notes:
# - This file models the intent/config surface area of the Terraform stack.
# - External Terraform modules are represented as higher-level resources.
# - The monitoring dashboard JSON is stubbed (see terraform/modules/monitoring/dashboard-pngu.json).

########################################
# Schema declarations
########################################

# Keep decl for true relational tables.
decl peering { env, name, peer_network }.

########################################
# Environment selection
########################################

# True anonymous wildcard `_` (Prolog / Souffle style).
has_env() :- input("env", _).
env(dev) :- not has_env().
env(E) :- input("env", E).

allowed_env(dev).
allowed_env(stg).
allowed_env(prod).

constraint("env must be one of: dev, stg, prod") :-
  env(E),
  not allowed_env(E).

########################################
# Settings (branch-as-data)
########################################

unique setting(2).

settings dev {
  project_id = "renfry-dev-973682"
  project_name = "renfry-dev"
  region = "us-east1"
  network_name = "renfry-dev-network"

  regional_proxy_cidr = "10.193.0.0/24"

  gke = {
    control_plane_cidr: "172.16.3.96/28",
    subnet_cidr: "10.141.76.0/22",
    pods_cidr: "10.141.80.0/21",
    services_cidr: "10.141.88.0/21",
    static_ips: { "pngu-grpc": { type: "INTERNAL" } }
  }
}.

settings stg {
  project_id = "renfry-stg"
  project_name = "renfry-stg"
  region = "us-east1"
  network_name = "renfry-stg-network"

  regional_proxy_cidr = "10.193.1.0/24"

  gke = {
    control_plane_cidr: "172.16.3.112/28",
    subnet_cidr: "10.141.100.0/22",
    pods_cidr: "10.141.104.0/21",
    services_cidr: "10.141.112.0/21",
    static_ips: { "pngu-grpc": { type: "INTERNAL" } }
  }
}.

settings prod {
  project_id = "renfry-prod"
  project_name = "renfry-prod"
  region = "us-east1"
  network_name = "renfry-prod-network"

  regional_proxy_cidr = "10.193.2.0/24"

  gke = {
    control_plane_cidr: "172.16.3.128/28",
    subnet_cidr: "10.141.124.0/22",
    pods_cidr: "10.141.128.0/21",
    services_cidr: "10.141.136.0/21",
    static_ips: { "pngu-grpc": { type: "INTERNAL" } }
  }
}.

########################################
# Peerings (explicit env-keyed table)
########################################

# dev
peering{ env: dev, name: envoy-dev, peer_network: "projects/envoy-dev-426188/global/networks/envoy-dev-network" }.

# stg
peering{ env: stg, name: envoy-stg, peer_network: "projects/envoy-stg-597462/global/networks/envoy-stg-network" }.
peering{ env: stg, name: envoy-stg-legacy, peer_network: "projects/coherentpath-stg/global/networks/envoy-proxy-stg" }.

# prod
peering{ env: prod, name: envoy-prod-legacy, peer_network: "projects/coherentpath-prod/global/networks/envoy-proxy-prod" }.

########################################
# Env-scoped validation/resources/outputs
########################################

when env(Env) {
  constraint("GKE static IPs must be INTERNAL") :-
    setting(Env, gke.static_ips.pngu-grpc.type, T),
    T != "INTERNAL".

  ########################################
  # Resources (renfry module intent)
  ########################################

  # GKE subnet (terraform-google-modules/network/google//modules/subnets)
  resource google_compute_subnetwork gke_subnet {
    project = ProjectId,
    region = Region,
    network = NetId,
    name = format("%s-gke-subnet", ProjectName),
    ip_cidr_range = SubnetCidr,
    subnet_private_access = true,
    secondary_ranges = [
      { range_name: format("%s-gke-pods-range", ProjectName), ip_cidr_range: PodsCidr },
      { range_name: format("%s-gke-svc-range", ProjectName), ip_cidr_range: ServicesCidr }
    ]
  } :-
    setting(Env, project_id, ProjectId),
    setting(Env, project_name, ProjectName),
    setting(Env, region, Region),
    setting(Env, network_name, NetworkName),
    NetId = format("projects/%s/global/networks/%s", ProjectId, NetworkName),
    setting(Env, gke.subnet_cidr, SubnetCidr),
    setting(Env, gke.pods_cidr, PodsCidr),
    setting(Env, gke.services_cidr, ServicesCidr).

  # Regional managed proxy subnet
  resource google_compute_subnetwork regional_proxy {
    project = ProjectId,
    region = Region,
    network = NetId,
    name = format("%s-proxy", ProjectName),
    purpose = "REGIONAL_MANAGED_PROXY",
    role = "ACTIVE",
    ip_cidr_range = ProxyCidr
  } :-
    setting(Env, project_id, ProjectId),
    setting(Env, project_name, ProjectName),
    setting(Env, region, Region),
    setting(Env, network_name, NetworkName),
    NetId = format("projects/%s/global/networks/%s", ProjectId, NetworkName),
    setting(Env, regional_proxy_cidr, ProxyCidr).

  # VPC peerings
  resource google_compute_network_peering PeeringRes {
    project = ProjectId,
    name = PeeringName,
    network = NetId,
    peer_network = PeerNet
  } :-
    setting(Env, project_id, ProjectId),
    setting(Env, network_name, NetworkName),
    NetId = format("projects/%s/global/networks/%s", ProjectId, NetworkName),
    peering{ env: Env, name: PeeringName, peer_network: PeerNet },
    PeeringRes = format("peering-%s", PeeringName).

  # Static IPs for services
  resource google_compute_address StaticIpRes {
    project = ProjectId,
    region = Region,
    name = IpName,
    address_type = IpType,
    subnetwork_id = ref(google_compute_subnetwork, gke_subnet, id)
  } :-
    setting(Env, project_id, ProjectId),
    setting(Env, region, Region),
    IpName = pngu-grpc,
    setting(Env, gke.static_ips.pngu-grpc.type, IpType),
    StaticIpRes = format("static-ip-%s", IpName).

  ########################################
  # Resources (GKE module intent)
  ########################################

  # Represents the external terraform-mi-gke module invocation.
  resource gke_cluster pngu {
    cluster_type = "autopilot-private",
    env = Env,
    project_id = ProjectId,
    project_name = ProjectName,
    name = format("%s-gke", ProjectName),
    network_id = NetId,
    subnetwork_id = ref(google_compute_subnetwork, gke_subnet, id),
    master_control_plane_cidr = CpCidr,
    ip_range_pods = format("%s-gke-pods-range", ProjectName),
    ip_range_services = format("%s-gke-svc-range", ProjectName),

    enable_secret_manager_addon = true,
    deletion_protection = false
  } :-
    setting(Env, project_id, ProjectId),
    setting(Env, project_name, ProjectName),
    setting(Env, network_name, NetworkName),
    NetId = format("projects/%s/global/networks/%s", ProjectId, NetworkName),
    setting(Env, gke.control_plane_cidr, CpCidr).

  ########################################
  # Resources (monitoring module intent)
  ########################################

  # Stubbed dashboard JSON: see terraform/modules/monitoring/dashboard-pngu.json
  resource google_monitoring_dashboard pngu {
    project = ProjectId,
    dashboard_json = { "displayName": "pngu", "note": "stubbed; see terraform/modules/monitoring/dashboard-pngu.json" }
  } :-
    setting(Env, project_id, ProjectId).

  # Represents terraform-gcp-alert-metrics module invocation.
  resource alert_metrics_pack pngu {
    project_id = ProjectId,
    notification_channel_type = "slack",
    notification_channel_display_name = "Slack",
    enable_standard_gke_alerts = true,
    source = "git@github.com:coherentpath/terraform-gcp-alert-metrics.git?ref=v1.5.0"
  } :-
    setting(Env, project_id, ProjectId).

  ########################################
  # Optional outputs (handy for wiring)
  ########################################

  output(active_env, Env).
  output(project_id, ProjectId) :- setting(Env, project_id, ProjectId).
}.
