edition 2026.

module database {
  input backup_days: int.
  input multi_az: bool.
  input subnet_ids: list(ref(net.subnet)).
  contributes iam_need.

  resource db.postgres db {
    public = false
    subnet_ids = SubnetIds
    backup_days = Days
    multi_az = MA
  } :-
    backup_days(Days),
    multi_az(MA),
    subnet_ids(SubnetIds).

  # Only when the database exists in this environment.
  iam_need(app, db.connect, ref(db.postgres, db, .id)) :- backup_days(_).
}.
