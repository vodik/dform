edition 2026.

module iam {
  resource iam.role app_role {
    name = app,
    assume = { principals: [k8s.serviceaccount.app] }
  }.

  resource iam.policy app_policy {
    name = app,
    # List comprehension sugar for collect(...)
    statements = [
      { action: Action, resource: Res }
      | iam_need(app, Action, Res)
    ]
  }.

  resource iam.role_policy_attachment attach {
    role_id = ref(iam.role, app_role, .id),
    policy_id = ref(iam.policy, app_policy, .id)
  }.
}.
