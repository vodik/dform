# Generated values: functions about a key (R-60; docs/grammar.md
# "Functions", "Memo"). Not random at all: each is derived by HKDF from
# the deployment's master secret (`RANDOM_MASTER` in the environment, else
# the stack's key file) with the deployment, the function, the key and
# every knob, so a value is the same on every run and a changed knob (or
# master) is a new value. Nothing is stored. A value that must be made once
# and kept whatever the master becomes is `memo.first(KEY, random.bytes(KEY,
# 32), V)`.
package random

#| A password for `key`: `length` characters (32 by default) of `alphabet`, one of "alnum" (the default), "ascii" (printable, no space), "hex" or "base64"; an error for another alphabet or a length outside 1..1024. A secret.
#| example: let pw = random.password("db-pw")
fn password(key: string, length?: int, alphabet?: string) -> secret(string)

#| `length` bytes for `key` (1..4096), as base64 text: a key for something that takes raw bytes. A secret.
#| example: let cookie = random.bytes("cookie-key", 32)
fn bytes(key: string, length: int) -> secret(string)

#| An identifier for `key`: `length` bytes (8 by default, 1..64) as hex. Public: a name may carry it.
#| example: let bucket = "logs-${random.id("logs")}"
fn id(key: string, length?: int) -> string

#| A UUID (version 4 in form) for `key`. Public.
#| example: let tenant = random.uuid("tenant")
fn uuid(key: string) -> string

#| An ed25519 signing key for `key` in Synapse's format, `ed25519 a_XXXX SEED` (the seed unpadded base64). A secret.
#| example: let signing = random.signing_key("synapse")
fn signing_key(key: string) -> secret(string)
