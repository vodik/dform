# Networks: functions about an `inet` (docs/grammar.md "Functions"). An
# `inet` is an IPv4 network, `10.0.0.0/16`: a string where one is wanted
# (a parameter, an attribute, `let n: inet = ".."`) is read as one there,
# a literal at compile time. `.addr` (its base address, an `ip`) and
# `.bits` (its prefix length) read its parts.
package inet

#| The `n`th subnet of `net` with `bits` more prefix bits; an error past a /32.
#| example: let cidr = inet.subnet(vpc.cidr, 4, zone_index[z])
fn subnet(net: inet, bits: int, n: int) -> inet

#| The network's `n`th usable host (network and broadcast excluded), an error past the last.
#| example: let private_ip = inet.host(cfg.vpc_net, 20)
fn host(net: inet, n: int) -> ip

#| The network's address `n` places after its base address.
#| example: let first = inet.addr(net, 0)
fn addr(net: inet, n: int) -> ip

#| Whether the network holds the address; also a predicate.
#| example: inside(a) where inet.contains("10.0.0.0/8", a)
fn contains(net: inet, addr: ip) -> bool

#| Whether two networks share an address; also a predicate.
#| example: deny "overlap" where inet.overlaps(a.cidr, b.cidr), a != b
fn overlaps(a: inet, b: inet) -> bool
