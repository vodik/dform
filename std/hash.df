# Digests: functions about a `string`'s SHA-256 (docs/grammar.md
# "Functions"). A secret may flow in; the result is inspected like any
# other (the secrets pass, E0301).
package hash

#| The text's SHA-256, lower-case hex; a short one is `str.slice(hash.sha256(s), 0, 8)`.
#| example: let digest = hash.sha256(key)
fn sha256(text: string) -> string
