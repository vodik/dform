# CSV: functions on a `string`'s CSV text and a list's (docs/grammar.md
# "Functions"). Over `io.read(LOCATION)`, a decode keeps each row at its
# line: `input p from csv.decode(io.read("data/p.csv"))`.
package csv

#| The rows the text decodes to, a list of objects by its header, every cell text (a column's type reads it where a relation's is declared); no value for text that is not CSV.
#| example: let rows = csv.decode(body)
fn decode(text: string) -> list? forwards

#| The list of objects as CSV text, a header of the first one's keys; an error for an object with other keys or a cell with no text (a list, an object, a reference, a null).
#| example: let body = csv.encode(rows)
fn encode(rows: list) -> string forwards
