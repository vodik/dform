# JSON: functions on a `string`'s JSON text and a value's (docs/grammar.md
# "Functions"). Over `io.read(LOCATION)`, a decode keeps the document's
# place, each row at its line: `json.decode(io.read("data/net.json"))`.
package json

#| The value the text decodes to, read as a document is (a null member absent, a whole float an int);
#| no value for text that is not JSON, or that has a fraction, a null elsewhere.
#| example: let cfg = json.decode(body)
fn decode(text: string) -> any? forwards

#| The value as JSON text; an error for a reference or a null.
#| example: let body = json.encode(cfg)
fn encode(value: any) -> string forwards
