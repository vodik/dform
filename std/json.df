# JSON: functions on a `string`'s JSON text and a value's (docs/grammar.md
# "Functions"). `json(path)` (the loader) stays for a document; these
# read and write the text of one already in hand.
package json

#| The value the text decodes to; no value for text that is not JSON, or whose numbers are not whole.
#| example: let cfg = json.decode(body)
fn decode(text: string) -> any?

#| The value as JSON text; no value for a reference or a null.
#| example: let body = json.encode(cfg)
fn encode(value: any) -> string?
