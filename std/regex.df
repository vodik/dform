# Pattern matching: functions about a `string` and a regular expression
# (docs/grammar.md "Functions"). A pattern is a `regex`: a string in a
# `regex`-typed position is checked at compile time (R-31); a bad
# pattern is a compile error at the literal.
package regex

#| Whether the text matches the pattern anywhere in it; also a predicate.
#| example: deny "bad name" where not regex.match(name, "^[a-z][a-z0-9-]*$")
fn match(text: string, re: regex) -> bool

#| The `n`th capture group (0 the whole match) of the pattern's first match in the text; no value when it does not match or has no such group.
#| example: let (repo, tag) = (regex.capture(image, "^(.+):([^:]+)$", 1), regex.capture(image, "^(.+):([^:]+)$", 2))
fn capture(text: string, re: regex, n: int) -> string?

#| The text with every match of the pattern replaced by `with` (`$1` for its first capture group).
#| example: let host = regex.replace(name, "[^a-z0-9-]", "-")
fn replace(text: string, re: regex, with: string) -> string
