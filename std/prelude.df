# The prelude: the functions written bare. Every other function is
# qualified by its package, the type it is about (`inet.subnet`,
# `str.split`). Signature files are read by the compiler, the language
# server and `dform doc` (docs/grammar.md "Functions"); the bodies are the
# engine's, looked up by qualified name.
#
#   fn NAME(PARAM: TYPE, ...) -> TYPE[?] [FLAG, ...]
#
# `?` after the result: partial, a call of a valid input may have no
# answer (the literal does not hold): a match that fails, a list that is
# empty, a text that is no document (R-134). Every other function answers
# every input it takes, and an input it does not (a bad unit, layout,
# template, port) is an error at the call. `forwards`: a secret argument
# flows through to the result uninspected (the secrets pass, E0301).
# `forwards nulls`: a null argument is not a content position (Rule 2).
# `internal`: the lowering's own, not callable from a program.
package prelude

#| An integer from its text or a float (toward zero; an integer is itself); an error for text that is not one. Strings never coerce silently.
#| example: let port = int(cfg.port)
fn int(value: any) -> int

#| A float from its text or an integer (a float is itself); an error for text that is not one.
#| example: let ratio = float(cfg.ratio)
fn float(value: any) -> float

#| The template with each `%s` replaced by the next value's text; an error when there are fewer values than `%s`. `"a${e}"` lowers to it.
#| example: let name = format("%s-%s", env, zone)
fn format(template: string, value: any, ...) -> string forwards

#| The number of elements of a list, keys of an object or characters of a string.
#| example: let zones = len(subnet_ids)
fn len(value: list) -> int

#| A reference to an attribute of the program's own resource: an apply-order edge; `vpc.cidr` in a field lowers to it. `ref(r)`, one resource, is the reference written out where an attribute that is no `ref(T)` takes one (R-43).
#| example: let vpc_cidr = ref(net.vpc, "vpc", "cidr")
fn ref(type: string, name: string, path: string) -> ref forwards

#| A name inside a used module or a copy, its path `scope.name` (R-112), as module lowering writes it.
#| example: let n = scoped("network.main", "vpc")
fn scoped(scope: string, name: string) -> string forwards

#| A reference to an attribute of an object in the world, one the program does not manage.
#| example: let adopted_id = cloud_ref(net.vpc, "existing-vpc", "id")
fn cloud_ref(type: string, name: string, path: string) -> ref

#| The value, its secret label removed; `declassified/2` records why (E DR-19).
#| example: let fingerprint = declassify(key.sha, "a digest is public")
fn declassify(value: any, reason: string) -> any forwards nulls

# Arithmetic: `a + b` lowers to `add(a, b)`, and so on.

#| The sum of two numbers (a float if either is, R-75); `a + b` lowers to it.
#| example: let n = replicas + 1
internal fn add(a: number, b: number) -> number forwards

#| The difference of two numbers (a float if either is); `a - b` lowers to it.
#| example: let spare = max - used
internal fn sub(a: number, b: number) -> number forwards

#| The product of two numbers (a float if either is); `a * b` lowers to it.
#| example: let bytes = gib * 1073741824
internal fn mul(a: number, b: number) -> number forwards

#| Integer division of two ints, else a float's; an error when `b` is 0; `a / b` lowers to it.
#| example: let half = n / 2
internal fn div(a: number, b: number) -> number forwards

#| The remainder of a division, an error when `b` is 0; `a % b` lowers to it.
#| example: odd(n) where n % 2 == 1
internal fn mod(a: number, b: number) -> number forwards

# The lowering's own (E §2.5): a declared attribute's null, its label,
# and a walk inside a value.

#| The null of an attribute path, its class and type from the schema row.
#| example: __null(T, A, P, "unknown", "string")
internal fn __null(
  type: string,
  name: string,
  path: string,
  class: string,
  ty: string,
) -> any forwards nulls

#| The label a null of an attribute path carries.
#| example: __label(T, A, P)
internal fn __label(type: string, name: string, path: string) -> string forwards nulls

#| The value read as the value type `ty` (`inet`, `time`, `bytes`, ..): a string parsed, a value of the type itself; an error at the position for a string that is not one. A typed position over a computed value lowers to it (`let n: inet = cfg.net`).
#| example: __as(cfg.net, "inet")
internal fn __as(value: any, ty: string) -> any forwards, forwards nulls

#| A quantity literal with no reading of its own (`500m`) until its position's type reads it (R-66); it has no value.
#| example: __quantity("500m", file, start, end)
internal fn __quantity(text: string, file: int, start: int, end: int) -> any?

#| The value nested at what `path` has past `prefix.`: `{a: {b: V}}` for `prefix.a.b`; no value for a path not under it. A key of a map input given by `--set` or `set from` lowers to it.
#| example: __under(K, "labels", V)
internal fn __under(path: string, prefix: string, value: any) -> any? forwards

#| A resource's name as one segment of its address: quoted when it holds a dot, `"a.b"` (R-112). A header name with holes lowers to it.
#| example: __segment(format("s-%s", Zone))
internal fn __segment(name: string) -> string forwards

#| A resource's value body, the value when it is an object, else none, an error naming it (R-126). `resource T N = VALUE` with a value known only at run time lowers to it.
#| example: __body(D)
internal fn __body(value: any) -> any? forwards

#| The value at a dotted path inside a value; `x.f` on a variable with no static type lowers to it.
#| example: __path(X, "f")
internal fn __path(value: any, path: string) -> any? forwards, forwards nulls

#| Whether a value is known: true of every value; over a null, undetermined, as any content position (Rule 2). `has r` of a resource lowers to it over the resource's identity (R-152).
#| example: __known(V)
internal fn __known(value: any) -> bool
