# Text: functions about a `string` (docs/grammar.md "Functions").
package str

#| The text's parts between each `sep` (not empty); with `limit`, split at the first `limit` of them only, so at most `limit + 1` parts: `(repo, tag) = str.split(image, ":", 1)` matches an image with a tag.
#| example: let parts = str.split("a,b", ",")
fn split(text: string, sep: string, limit?: int) -> list(string) forwards

#| The text in lower case.
#| example: let name = str.lower(team)
fn lower(text: string) -> string forwards

#| The text in upper case.
#| example: let code = str.upper(region)
fn upper(text: string) -> string forwards

#| The text with the leading indentation its non-blank lines share removed, a blank line emptied, and the line break right after the opening quote dropped: for a string literal that spans lines, indented with the program.
#| example: let script = str.dedent("\n    #!/bin/sh\n    echo ${name}\n  ")
fn dedent(text: string) -> string forwards

#| The text with leading and trailing whitespace removed.
#| example: let name = str.trim(" web ")
fn trim(text: string) -> string forwards

#| The text with every `from` replaced by `to`.
#| example: let host = str.replace(name, "_", "-")
fn replace(text: string, from: string, to: string) -> string forwards

#| Whether the text starts with `prefix`; also a predicate.
#| example: deny "bad prefix" where not str.starts_with(name, "web-")
fn starts_with(text: string, prefix: string) -> bool

#| Whether the text ends with `suffix`; also a predicate.
#| example: deny "bad suffix" where not str.ends_with(image, ":latest")
fn ends_with(text: string, suffix: string) -> bool

#| The text padded on the left with `pad` to at least `width` characters; an error when `pad` is empty.
#| example: let n = str.pad_left("${i}", 3, "0")
fn pad_left(text: string, width: int, pad: string) -> string forwards

#| The text padded on the right with `pad` to at least `width` characters; an error when `pad` is empty.
#| example: let row = str.pad_right(name, 20, " ")
fn pad_right(text: string, width: int, pad: string) -> string forwards

#| The characters from `start` up to but not including `end` (to the end when left out); an error past the text's length or for an end before its start.
#| example: let (repo, tag) = (str.slice(image, 0, i), str.slice(image, i + 1))
fn slice(text: string, start: int, end?: int) -> string forwards
