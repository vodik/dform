# URLs: functions about a `url` (docs/grammar.md "Functions"). A `url`
# value is parsed at the edge and prints canonically; a literal in a
# `url`-typed position is checked at compile time (R-31).
package url

#| The url with `segment` appended to its path, one `/` between them whatever either side has.
#| example: let endpoint = url.join(base_url, "v1/status")
fn join(base: url, segment: string) -> url forwards

#| The url with its scheme set.
#| example: let secure = url.with_scheme(u, "https")
fn with_scheme(u: url, scheme: string) -> url forwards

#| The url with its host set.
#| example: let canary = url.with_host(u, "canary.${domain}")
fn with_host(u: url, host: string) -> url forwards

#| The url with its port set.
#| example: let direct = url.with_port(u, 8443)
fn with_port(u: url, port: int) -> url forwards

#| The url with its path set.
#| example: let health = url.with_path(u, "/healthz")
fn with_path(u: url, path: string) -> url forwards

#| The url with its query set, replacing any it had.
#| example: let paged = url.with_query(u, { page: "2" })
fn with_query(u: url, query: object) -> url forwards

#| The text, percent-encoded for a URL path or query component.
#| example: let safe = url.encode(team_name)
fn encode(text: string) -> string forwards
