# Semantic versions: functions about a version string, Cargo's syntax
# (docs/grammar.md "Functions").
package semver

#| The version's major, minor and patch numbers and its pre-release tag; no value for text that is not a semantic version.
#| example: let v = semver.parse(image_tag)
fn parse(text: string) -> { major: int, minor: int, patch: int, pre: string? }?

#| Whether the version satisfies the range (Cargo's syntax, `"^1.2"`, `">=1, <2"`); no value when either is not valid semver.
#| example: deny "chart too old" where not semver.satisfies(chart.version, "^2.0")
fn satisfies(version: string, range: string) -> bool?

#| -1, 0 or 1 as `a` is before, the same as, or after `b`; no value when either is not a semantic version.
#| example: deny "downgrade" where semver.compare(next.version, current.version) < 0
fn compare(a: string, b: string) -> int?
