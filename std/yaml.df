# YAML: functions on a `string`'s YAML text and a value's (docs/grammar.md
# "Functions"). `yaml(path)` (the loader) stays for a document; these
# read and write the text of one already in hand.
package yaml

#| The value the text decodes to, read as a document is (a null member absent, a whole float an int);
#| no value for text that is not YAML, or that has a fraction, a null elsewhere or a tag.
#| example: let cfg = yaml.decode(body)
fn decode(text: string) -> any? forwards

#| The value as YAML text; an error for a reference or a null.
#| example: let body = yaml.encode(cfg)
fn encode(value: any) -> string forwards
