# TOML: functions on a `string`'s TOML text and a value's (docs/grammar.md
# "Functions"). `toml(path)` (the loader) stays for a document; these
# read and write the text of one already in hand.
package toml

#| The value the text decodes to; no value for text that is not TOML, or whose numbers are not whole.
#| example: let cfg = toml.decode(body)
fn decode(text: string) -> any?

#| The value as TOML text; no value for a reference, a null, or a value whose root is not an object.
#| example: let body = toml.encode(cfg)
fn encode(value: any) -> string?
