# TOML: functions on a `string`'s TOML text and a value's (docs/grammar.md
# "Functions"). Over `io.read(LOCATION)`, a decode keeps the document's
# place, each row at its line: `toml.decode(io.read("data/net.toml"))`.
package toml

#| The value the text decodes to, read as a document is (a null member absent, a whole float an int);
#| no value for text that is not TOML, or that has a fraction, a null elsewhere or a local datetime.
#| example: let cfg = toml.decode(body)
fn decode(text: string) -> any? forwards

#| The value as TOML text; an error for a reference, a null, or a value whose root is not an object.
#| example: let body = toml.encode(cfg)
fn encode(value: any) -> string forwards
