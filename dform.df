# dform demo: component-scoped resources + settings tables + IAM policy assembly.
#
# Try:
#   cargo run -- plan
#   cargo run -- plan --set env=prod
#   cargo run -- apply

edition 2026.

# Defaults (stratified negation)
has_env() :- input("env", _).
env(staging) :- not has_env().
env(E) :- input("env", E).

data(zone, "us-test-1a").
data(zone, "us-test-1b").

# Guard blocks (when) apply a condition to everything inside.
when env(prod) {
  iam_need(app, audit.write, "audit-log").
}.

# Settings (branch as data). One @default layer for every environment that
# has one; a per-environment block wins per leaf at the normal rank.
env_name(staging).
env_name(prod).

settings E @default {
  network.main.vpc_net = inet("10.50.0.0/16")
  network.peer.vpc_net = inet("10.60.0.0/16")
  db = { backup_days: 3, multi_az: false }
  k8s = { private_api: false, nodepool: { min: 1, max: 3 } }
} :- env_name(E).

settings prod {
  network.main.vpc_net = inet("10.20.0.0/16")
  network.peer.vpc_net = inet("10.21.0.0/16")
  db = { backup_days: 14, multi_az: true }
  k8s = { private_api: true, nodepool: { min: 3, max: 10 } }
  audit.sinks += ["cloudwatch"] # a set: unions with the baseline pack's ["s3"]
}.

settings dev {
  network.main.vpc_net = inet("10.90.0.0/16")
}.

import "modules/network.df".
import "modules/database.df".
import "modules/kubernetes.df".
import "modules/iam.df".
import "policies/baseline.df".
import "modules/stdlib_net.df".

apply baseline.

# Instantiate modules (Terraform module-like).
instance network main {
  vpc_net = VpcNet
} :-
  env(Env),
  setting(Env, .network.main.vpc_net, VpcNet).

instance network peer {
  vpc_net = VpcNet
} :-
  env(Env),
  setting(Env, .network.peer.vpc_net, VpcNet).

instance database main {
  backup_days = Days
  multi_az = MA
} :-
  env(Env),
  setting(Env, .db.backup_days, Days),
  setting(Env, .db.multi_az, MA).

instance kubernetes main {
  private_api = PrivateApi
  nodepool_min = Min
  nodepool_max = Max
} :-
  env(Env),
  setting(Env, .k8s.private_api, PrivateApi),
  setting(Env, .k8s.nodepool.min, Min),
  setting(Env, .k8s.nodepool.max, Max).

instance iam main {}.

# VPC peering intent: define edges between network instances.
vpc_peer_inst(main, peer).

# Resolve instance names to actual VPC resource names (scoped addresses).
vpc_peer(A, B) :-
  vpc_peer_inst(InstA, InstB),
  component_scope(network, InstA, ScopeA),
  component_scope(network, InstB, ScopeB),
  A = scoped(ScopeA, vpc),
  B = scoped(ScopeB, vpc).

# Create a peering resource per declared peering edge.
resource net.vpc_peering Peer {
  requester_vpc_id = ref(net.vpc, A, .id)
  accepter_vpc_id = ref(net.vpc, B, .id)
} :-
  vpc_peer_inst(InstA, InstB),
  vpc_peer(A, B),
  want(net.vpc, A), # both ends must exist in this environment
  want(net.vpc, B),
  Peer = format("peer-%s-%s", InstA, InstB).

# Demo: allocate an IP from the main VPC.
resource compute.vm bastion {
  private_ip = inet_host(VpcNet, 20)
} :-
  env(Env),
  setting(Env, .network.main.vpc_net, VpcNet).

# Constraints (policy)
constraint("prod db must be multi_az") :-
  env(prod),
  component_scope(database, main, DbScope),
  Db = scoped(DbScope, db),
  want(db.postgres, Db),
  not arg(db.postgres, Db, .multi_az, true).

constraint("prod k8s must have private api") :-
  env(prod),
  component_scope(kubernetes, main, KScope),
  C = scoped(KScope, cluster),
  want(k8s.cluster, C),
  not arg(k8s.cluster, C, .private_api, true).
