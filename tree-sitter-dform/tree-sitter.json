{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "dform",
      "camelcase": "Dform",
      "title": "dform",
      "scope": "source.dform",
      "path": ".",
      "file-types": ["df"],
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "injection-regex": "^dform$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "description": "dform grammar for tree-sitter",
    "authors": [{ "name": "Simon Gomizelj" }]
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
